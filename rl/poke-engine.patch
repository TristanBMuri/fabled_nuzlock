+pub fn rr_needs_last_used_move(state: &State) -> bool {
+    for s in [&state.side_one, &state.side_two] {
+        for pkmn in s.pokemon.into_iter() {
+            if matches!(
+                pkmn.ability,
+                Abilities::BULLRUSH | Abilities::QUILLRUSH | Abilities::THELOOK
+            ) {
+                return true;
+            }
+        }
+    }
+    false
+}
