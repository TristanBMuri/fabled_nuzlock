+#[test]
+fn test_rr_frostbite_allows_moving_halves_special_and_residual_damage() {
+    let mut state = State::default();
+    state.side_one.get_active().hp = 320;
+    state.side_one.get_active().maxhp = 320;
+    state.side_one.get_active().status = PokemonStatus::FREEZE;
+    state.side_two.get_active().hp = 500;
+    state.side_two.get_active().maxhp = 500;
+
+    // 1. Frostbitten mon moves 100% of the time (no 80% frozen skip, no 20% thaw)
+    let out = run_turn(&mut state, Choices::PSYCHIC, Choices::SPLASH);
+    // Psychic has 10% SpD drop -> 2 branches (90% and 10%), NOT frozen skip branches
+    let total_pct: f32 = out.iter().map(|s| s.percentage).sum();
+    assert!((total_pct - 100.0).abs() < 0.01);
+    for branch in &out {
+        // Deals damage (didn't get frozen)
+        assert!(branch.instruction_list.iter().any(|i| matches!(
+            i,
+            Instruction::Damage(DamageInstruction {
+                side_ref: SideReference::SideTwo,
+                ..
+            })
+        )));
+        // Takes 1/16 residual frostbite damage = 320 / 16 = 20
+        assert!(branch.instruction_list.contains(&Instruction::Damage(
+            DamageInstruction {
+                side_ref: SideReference::SideOne,
+                damage_amount: 20,
+            }
+        )));
+    }
+
+    // 2. Special damage is halved by Frostbite
+    let surf = MOVES.get(&Choices::SURF).unwrap();
+    let (frz_dmg, _) = calculate_damage(&state, &SideReference::SideOne, surf, DamageRolls::Max).unwrap();
+    state.side_one.get_active().status = PokemonStatus::NONE;
+    let (norm_dmg, _) = calculate_damage(&state, &SideReference::SideOne, surf, DamageRolls::Max).unwrap();
+    assert!((frz_dmg as f32 / norm_dmg as f32 - 0.5).abs() < 0.05);
+
+    // 3. Thick Fat halves Frostbite residual damage to 1/32 = 10
+    state.side_one.get_active().status = PokemonStatus::FREEZE;
+    state.side_one.get_active().ability = Abilities::THICKFAT;
+    let tf_out = run_turn(&mut state, Choices::SPLASH, Choices::SPLASH);
+    assert!(tf_out[0].instruction_list.contains(&Instruction::Damage(
+        DamageInstruction {
+            side_ref: SideReference::SideOne,
+            damage_amount: 10,
+        }
+    )));
+
+    // 4. Hit by Fire-type damaging move cures Frostbite
+    let mut fire_state = State::default();
+    fire_state.side_two.get_active().status = PokemonStatus::FREEZE;
+    fire_state.side_two.get_active().hp = 400;
+    fire_state.side_two.get_active().maxhp = 400;
+    let fire_out = run_turn(&mut fire_state, Choices::EMBER, Choices::SPLASH);
+    assert!(fire_out[0].instruction_list.contains(&Instruction::ChangeStatus(
+        ChangeStatusInstruction {
+            side_ref: SideReference::SideTwo,
+            pokemon_index: PokemonIndex::P0,
+            old_status: PokemonStatus::FREEZE,
+            new_status: PokemonStatus::NONE,
+        }
+    )));
+}
