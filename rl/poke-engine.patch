+/// RR defending type overrides (Draco Barrage hits Fairy, Divine Judgment hits Ghost).
+pub fn rr_adjust_defending_types(
+    choice: &Choice,
+    mut defender_types: (PokemonType, PokemonType),
+) -> (PokemonType, PokemonType) {
+    if choice.move_id == Choices::DRACOBARRAGE && choice.move_type == PokemonType::DRAGON {
+        if defender_types.0 == PokemonType::FAIRY {
+            defender_types.0 = PokemonType::TYPELESS;
+        }
+        if defender_types.1 == PokemonType::FAIRY {
+            defender_types.1 = PokemonType::TYPELESS;
+        }
+    } else if choice.move_id == Choices::DIVINEJUDGMENT && choice.move_type == PokemonType::NORMAL {
+        if defender_types.0 == PokemonType::GHOST {
+            defender_types.0 = PokemonType::TYPELESS;
+        }
+        if defender_types.1 == PokemonType::GHOST {
+            defender_types.1 = PokemonType::TYPELESS;
+        }
+    }
+    defender_types
+}
