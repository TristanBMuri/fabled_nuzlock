+pub fn rr_modify_attacking_stat(
+    attacker: &Pokemon,
+    defender: &Pokemon,
+    _attacking_side: &Side,
+    _defending_side: &Side,
+    choice: &Choice,
+    effective_weather: Weather,
+    attacking_final_stat: &mut i16,
+    crit_attacking_stat: &mut i16,
+) {
+    if attacker.ability != Abilities::NEUTRALIZINGGAS
+        && defender.ability != Abilities::NEUTRALIZINGGAS
+    {
+        match attacker.ability {
+            Abilities::CASHSPLASH => {
+                if choice.move_type == PokemonType::WATER {
+                    *attacking_final_stat = chain_modify_i16(*attacking_final_stat, 8192);
+                    *crit_attacking_stat = chain_modify_i16(*crit_attacking_stat, 8192);
+                }
+            }
+            Abilities::FELINEPROWESS => {
+                if choice.category == MoveCategory::Special {
+                    *attacking_final_stat = chain_modify_i16(*attacking_final_stat, 8192);
+                    *crit_attacking_stat = chain_modify_i16(*crit_attacking_stat, 8192);
+                }
+            }
+            Abilities::SAGEPOWER => {
+                if choice.category == MoveCategory::Special {
+                    *attacking_final_stat = chain_modify_i16(*attacking_final_stat, 6144);
+                    *crit_attacking_stat = chain_modify_i16(*crit_attacking_stat, 6144);
+                }
+            }
+            Abilities::DEFEATIST => {
+                if attacker.hp <= attacker.maxhp / 3 {
+                    *attacking_final_stat = chain_modify_i16(*attacking_final_stat, 2048);
+                    *crit_attacking_stat = chain_modify_i16(*crit_attacking_stat, 2048);
+                }
+            }
+            Abilities::SOLARPOWER => {
+                if choice.category == MoveCategory::Special
+                    && matches!(effective_weather, Weather::SUN | Weather::HARSHSUN)
+                {
+                    *attacking_final_stat = chain_modify_i16(*attacking_final_stat, 6144);
+                    *crit_attacking_stat = chain_modify_i16(*crit_attacking_stat, 6144);
+                }
+            }
+            Abilities::FLOWERGIFT => {
+                if choice.category == MoveCategory::Physical
+                    && matches!(
+                        attacker.id,
+                        PokemonName::CHERRIM | PokemonName::CHERRIMSUNSHINE
+                    )
+                    && matches!(effective_weather, Weather::SUN | Weather::HARSHSUN)
+                {
+                    *attacking_final_stat = chain_modify_i16(*attacking_final_stat, 6144);
+                    *crit_attacking_stat = chain_modify_i16(*crit_attacking_stat, 6144);
+                }
+            }
+            _ => {}
+        }
+        if !ignores_target_ability(attacker, choice, &defender.ability) {
+            match defender.ability {
+                Abilities::CASHSPLASH => {
+                    if choice.move_type == PokemonType::FIRE {
+                        *attacking_final_stat = chain_modify_i16(*attacking_final_stat, 2048);
+                        *crit_attacking_stat = chain_modify_i16(*crit_attacking_stat, 2048);
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+}
