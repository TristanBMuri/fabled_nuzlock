+pub fn rr_ability_modify_attack_being_used(
+    state: &State,
+    attacker_choice: &mut Choice,
+    defender_choice: &Choice,
+    attacking_side_ref: &SideReference,
+) {
+    let (attacking_side, defending_side) = state.get_both_sides_immutable(attacking_side_ref);
+    let attacking_pkmn = attacking_side.get_active_immutable();
+    if defending_side.get_active_immutable().ability == Abilities::NEUTRALIZINGGAS {
+        return;
+    }
+    match attacking_pkmn.ability {
+        Abilities::BADCOMPANY => {
+            if attacker_choice.move_id != Choices::STRUGGLE {
+                attacker_choice.recoil = None;
+            }
+        }
+        Abilities::BULLRUSH | Abilities::QUILLRUSH => {
+            if attacker_choice.category == MoveCategory::Physical
+                && !matches!(attacking_side.last_used_move, LastUsedMove::Move(_))
+            {
+                attacker_choice.base_power = chain_modify_bp(attacker_choice.base_power, 4915);
+            }
+        }
+        Abilities::FATALPRECISION => {
+            let defender = defending_side.get_active_immutable();
+            if type_effectiveness_modifier(&attacker_choice.move_type, defender) > 1.0 {
+                attacker_choice.base_power = chain_modify_bp(attacker_choice.base_power, 4915);
+                attacker_choice.accuracy = 100.0;
+            }
+        }
+        Abilities::STRIKER => {
+            if is_kick_move(attacker_choice.move_id) {
+                attacker_choice.base_power = chain_modify_bp(attacker_choice.base_power, 5325);
+            }
+        }
+        Abilities::IRONFIST => {
+            if attacker_choice.flags.punch {
+                attacker_choice.base_power = chain_modify_bp(attacker_choice.base_power, 5325);
+            }
+        }
+        Abilities::RECKLESS => {
+            if attacker_choice.crash.is_some()
+                || attacker_choice.recoil.is_some()
+                || matches!(
+                    attacker_choice.move_id,
+                    Choices::EXPLOSION | Choices::SELFDESTRUCT | Choices::MISTYEXPLOSION
+                )
+            {
+                attacker_choice.base_power = chain_modify_bp(attacker_choice.base_power, 4915);
+            }
+        }
+        Abilities::LIQUIDVOICE => {
+            if attacker_choice.flags.sound {
+                attacker_choice.move_type = PokemonType::WATER;
+                attacker_choice.base_power = chain_modify_bp(attacker_choice.base_power, 4915);
+            }
+        }
+        Abilities::FLAREBOOST => {
+            if attacking_pkmn.status == PokemonStatus::BURN
+                && attacker_choice.category == MoveCategory::Special
+            {
+                attacker_choice.base_power = chain_modify_bp(attacker_choice.base_power, 6144);
+            }
+        }
+        Abilities::TOXICBOOST => {
+            if (attacking_pkmn.status == PokemonStatus::POISON
+                || attacking_pkmn.status == PokemonStatus::TOXIC)
+                && attacker_choice.category == MoveCategory::Physical
+            {
+                attacker_choice.base_power = chain_modify_bp(attacker_choice.base_power, 6144);
+            }
+        }
+        Abilities::ILLUMINATE => {
+            if !attacker_choice.move_id.ignores_evasion() {
+                attacker_choice.accuracy = chain_modify_bp(attacker_choice.accuracy, 4915);
+            }
+        }
+        Abilities::BATTLEBOND => {
+            if attacking_pkmn.id == PokemonName::GRENINJAASH
+                && attacker_choice.move_id == Choices::WATERSHURIKEN
+            {
+                attacker_choice.base_power += 5.0;
+            }
+        }
+        Abilities::ASSHOLESINSUFFERABLENESS => {
+            if attacker_choice.flags.sound {
+                attacker_choice.base_power = chain_modify_bp(attacker_choice.base_power, 12288);
+            }
+        }
+        Abilities::VOCALIZER => {
+            if attacker_choice.flags.sound {
+                attacker_choice.base_power = chain_modify_bp(attacker_choice.base_power, 5325);
+            }
+        }
+        Abilities::PARASITICWASTE => {
+            if attacker_choice.category != MoveCategory::Status {
+                let can_poison = attacker_choice.secondaries.as_ref().is_some_and(|secs| {
+                    secs.iter().any(|s| {
+                        matches!(
+                            s.effect,
+                            Effect::Status(PokemonStatus::POISON | PokemonStatus::TOXIC)
+                        )
+                    })
+                });
+                if can_poison {
+                    attacker_choice.drain = Some(0.5);
+                }
+            }
+        }
+        _ => {}
+    }
+}
