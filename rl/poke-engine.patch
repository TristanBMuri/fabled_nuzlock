+#[test]
+fn test_rr_new_items_burntseed_leekstick_orbs_and_zcrystals() {
+    // Burnt Seed boosts Sunflora Fire moves 1.5x
+    let mut sf = State::default();
+    sf.side_one.get_active().id = PokemonName::SUNFLORA;
+    sf.side_two.get_active().hp = 500;
+    let base_out = run_turn(&mut sf, Choices::FLAMETHROWER, Choices::SPLASH);
+    let base_dmg = base_out[0]
+        .instruction_list
+        .iter()
+        .find_map(|i| match i {
+            Instruction::Damage(d) => Some(d.damage_amount),
+            _ => None,
+        })
+        .unwrap();
+    sf.side_one.get_active().item = Items::BURNTSEED;
+    let seed_out = run_turn(&mut sf, Choices::FLAMETHROWER, Choices::SPLASH);
+    let seed_dmg = seed_out[0]
+        .instruction_list
+        .iter()
+        .find_map(|i| match i {
+            Instruction::Damage(d) => Some(d.damage_amount),
+            _ => None,
+        })
+        .unwrap();
+    assert!((seed_dmg as f32 / base_dmg as f32 - 1.5).abs() < 0.08);
+
+    // Leek Stick: Farfetch'd gets 1.5x speed and +1 crit, Sirfetch'd gets +2 crit
+    let mut ff = State::default();
+    ff.side_one.get_active().id = PokemonName::FARFETCHD;
+    ff.side_one.get_active().item = Items::LEEKSTICK;
+    ff.side_one.get_active().speed = 100; // 150 effective
+    ff.side_two.get_active().speed = 130;
+    ff.side_two.get_active().hp = 1;
+    let ff_out = run_turn(&mut ff, Choices::TACKLE, Choices::TACKLE);
+    assert!(!ff_out[0].instruction_list.iter().any(|i| matches!(
+        i,
+        Instruction::Damage(DamageInstruction {
+            side_ref: SideReference::SideOne,
+            ..
+        })
+    )));
+
+    // Eternamax Orb & Council Orb transform on switch-in
+    let mut orb = State::default();
+    orb.side_one.pokemon[PokemonIndex::P1].id = PokemonName::ETERNATUS;
+    orb.side_one.pokemon[PokemonIndex::P1].item = Items::ETERNAMAXORB;
+    orb.side_one.pokemon[PokemonIndex::P1].hp = 300;
+    orb.side_one.pokemon[PokemonIndex::P1].maxhp = 300;
+    orb.side_two
+        .get_active()
+        .replace_move(PokemonMoveIndex::M0, Choices::SPLASH);
+    let orb_out = generate_instructions_from_move_pair(
+        &mut orb,
+        &MoveChoice::Switch(PokemonIndex::P1),
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+        false,
+    );
+    orb.apply_instructions(&orb_out[0].instruction_list);
+    assert_eq!(orb.side_one.get_active().id, PokemonName::ETERNATUSETERNAMAX);
+    assert_eq!(orb.side_one.get_active().ability, Abilities::LEVITATE);
+
+    // Mega stones & Z crystals parse cleanly
+    for item_id in [
+        "alcremite",
+        "butterfrite",
+        "centiskitesevii",
+        "toxtricititelowkey",
+        "firiumz",
+        "normaliumz",
+        "ultranecroziumz",
+    ] {
+        assert_ne!(Items::from_str(item_id).unwrap(), Items::UNKNOWNITEM);
+    }
+}
