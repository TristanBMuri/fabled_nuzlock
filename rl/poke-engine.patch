+#[test]
+fn test_rr_hidden_power_all_types() {
+    let cases = [
+        ("hiddenpowerbug", Choices::HIDDENPOWERBUG, PokemonType::BUG),
+        ("hiddenpowerdark", Choices::HIDDENPOWERDARK, PokemonType::DARK),
