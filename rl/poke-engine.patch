+/// RR `choice_before_move` hooks (Skull Bash +1 Atk/+1 Def on charge turn, Sacrificial Room sets 3-turn Trick Room).
+pub fn rr_choice_before_move(
+    state: &mut State,
+    choice: &mut Choice,
+    attacking_side_ref: &SideReference,
+    instructions: &mut StateInstructions,
+) {
+    match choice.move_id {
+        Choices::SKULLBASH if choice.flags.charge => {
+            let attacking_side = state.get_side(attacking_side_ref);
+            apply_boost_instruction(
+                attacking_side,
+                &PokemonBoostableStat::Attack,
+                &1,
+                attacking_side_ref,
+                attacking_side_ref,
+                instructions,
+            );
+            apply_boost_instruction(
+                attacking_side,
+                &PokemonBoostableStat::Defense,
+                &1,
+                attacking_side_ref,
+                attacking_side_ref,
+                instructions,
+            );
+        }
+        Choices::SACRIFICIALROOM => {
+            // Sets Trick Room (and Magic/Wonder Room) for 3 turns even if already active
+            let was_active = state.trick_room.active;
+            let prev_turns = state.trick_room.turns_remaining;
+            if was_active {
+                instructions
+                    .instruction_list
+                    .push(Instruction::ToggleTrickRoom(ToggleTrickRoomInstruction {
+                        currently_active: true,
+                        new_trickroom_turns_remaining: 0,
+                        previous_trickroom_turns_remaining: prev_turns,
+                    }));
+                state.trick_room.active = false;
+                state.trick_room.turns_remaining = 0;
+            }
+            instructions
+                .instruction_list
+                .push(Instruction::ToggleTrickRoom(ToggleTrickRoomInstruction {
+                    currently_active: false,
+                    new_trickroom_turns_remaining: 3,
+                    previous_trickroom_turns_remaining: 0,
+                }));
+            state.trick_room.active = true;
+            state.trick_room.turns_remaining = 3;
+        }
+        _ => {}
+    }
+}
