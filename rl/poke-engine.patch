index 0000000..54ba5b7
--- /dev/null
+++ b/tests/test_rr_mega.rs
@@ -0,0 +1,190 @@
+#![cfg(feature = "rr")]
+// Radical Red mega evolution. Expected values from the RR Showdown fork (gen9rrcustomgamenogimmicks,
+// level 50, 85 EVs, 31 IVs, Serious): Kingler@Kinglerite vs Pikachu, then Lapras@Laprasite.
+
+use poke_engine::choices::Choices;
+use poke_engine::engine::abilities::Abilities;
+use poke_engine::engine::generate_instructions::generate_instructions_from_move_pair;
+use poke_engine::engine::items::Items;
+use poke_engine::engine::state::MoveChoice;
+use poke_engine::instruction::Instruction;
+use poke_engine::pokemon::PokemonName;
+use poke_engine::state::{PokemonIndex, PokemonMoveIndex, PokemonType, SideReference, State};
+
+const M0: PokemonMoveIndex = PokemonMoveIndex::M0;
+
+// side one: Kingler@Kinglerite lead, Lapras@Laprasite on the bench; side two: Pikachu
+// (speed 121: slower than Kingler-Mega's 141, faster than Kingler's 106)
+fn state() -> State {
+    let mut state = State::default();
+    let s1 = &mut state.side_one.pokemon;
+    let k = &mut s1[PokemonIndex::P0];
+    k.id = PokemonName::KINGLER;
+    k.item = Items::KINGLERITE;
+    k.level = 50;
+    k.types = (PokemonType::WATER, PokemonType::TYPELESS);
+    k.ability = Abilities::HYPERCUTTER;
+    k.base_ability = Abilities::HYPERCUTTER;
+    (k.hp, k.maxhp) = (141, 141);
+    (k.attack, k.defense, k.special_attack, k.special_defense, k.speed) = (161, 146, 81, 81, 106);
+    k.replace_move(M0, Choices::TACKLE);
+    let l = &mut s1[PokemonIndex::P1];
+    l.id = PokemonName::LAPRAS;
+    l.item = Items::LAPRASITE;
+    l.level = 50;
+    l.types = (PokemonType::WATER, PokemonType::DRAGON);
+    l.ability = Abilities::WATERABSORB;
+    l.base_ability = Abilities::WATERABSORB;
+    (l.hp, l.maxhp) = (216, 216);
+    (l.attack, l.defense, l.special_attack, l.special_defense, l.speed) = (116, 111, 116, 126, 91);
+    l.replace_move(M0, Choices::TACKLE);
+    let p = state.side_two.get_active();
+    p.id = PokemonName::PIKACHU;
+    p.level = 50;
+    (p.hp, p.maxhp) = (121, 121);
+    p.speed = 121;
+    p.replace_move(M0, Choices::TACKLE);
+    state
+}
+
+fn moves(options: &[MoveChoice]) -> Vec<MoveChoice> {
+    options
+        .iter()
+        .filter(|c| !matches!(c, MoveChoice::Switch(_)))
+        .cloned()
+        .collect()
+}
+
+// side of the first Damage instruction of every branch (who hit first)
+fn first_hit(state: &mut State, s1: MoveChoice) -> Vec<SideReference> {
+    let branches = generate_instructions_from_move_pair(state, &s1, &MoveChoice::Move(M0), false);
+    branches
+        .iter()
+        .map(|b| {
+            b.instruction_list
+                .iter()
+                .find_map(|i| match i {
+                    Instruction::Damage(d) => Some(d.side_ref),
+                    _ => None,
+                })
+                .unwrap()
+        })
+        .collect()
+}
+
+#[test]
+fn test_rr_stone_holder_only_has_mega_moves() {
+    let state = state();
+    let (s1, s2) = state.get_all_options();
+    assert!(moves(&s1).iter().all(|c| matches!(c, MoveChoice::MoveMega(_))));
+    assert_eq!(moves(&s1).len(), 4);
+    assert!(moves(&s2).iter().all(|c| matches!(c, MoveChoice::Move(_))));
+}
+
+#[test]
+fn test_rr_mega_on_first_move_stats_ability_types() {
+    let mut state = state();
+    let branches = generate_instructions_from_move_pair(
+        &mut state,
+        &MoveChoice::MoveMega(M0),
+        &MoveChoice::Move(M0),
+        false,
+    );
+    state.apply_instructions(&branches[0].instruction_list);
+    let k = state.side_one.get_active_immutable();
+    assert_eq!(PokemonName::KINGLERMEGA, k.id);
+    assert_eq!(
+        (181, 161, 81, 106, 141),
+        (k.attack, k.defense, k.special_attack, k.special_defense, k.speed)
+    );
+    assert_eq!(141, k.maxhp);
+    assert_eq!((PokemonType::WATER, PokemonType::STEEL), k.types);
+    assert_eq!(Abilities::TOUGHCLAWS, k.ability);
+    assert!(k.mega_evolved);
+    assert_eq!(Items::KINGLERITE, k.item);
+    assert!(!k.item_can_be_removed());
+}
+
+#[test]
+fn test_rr_mega_turn_uses_the_mega_speed() {
+    // Showdown: Kingler-Mega (141) moves before Pikachu (121) on the mega turn
+    let mut state = state();
+    for side in first_hit(&mut state, MoveChoice::MoveMega(M0)) {
+        assert_eq!(SideReference::SideTwo, side);
+    }
+    // without the stone Kingler (106) is slower
+    state.side_one.get_active().item = Items::LEFTOVERS;
+    for side in first_hit(&mut state, MoveChoice::Move(M0)) {
+        assert_eq!(SideReference::SideOne, side);
+    }
+}
+
+#[test]
+fn test_rr_mega_once_per_side() {
+    let mut state = state();
+    let branches = generate_instructions_from_move_pair(
+        &mut state,
+        &MoveChoice::MoveMega(M0),
+        &MoveChoice::Move(M0),
+        false,
+    );
+    state.apply_instructions(&branches[0].instruction_list);
+    // the mega cannot mega again, and Lapras (bench, holds Laprasite) cannot either
+    let (s1, _) = state.get_all_options();
+    assert!(moves(&s1).iter().all(|c| matches!(c, MoveChoice::Move(_))));
+    state.side_one.active_index = PokemonIndex::P1;
+    let (s1, _) = state.get_all_options();
+    assert!(moves(&s1).iter().all(|c| matches!(c, MoveChoice::Move(_))));
+}
+
+#[test]
+fn test_rr_no_mega_without_its_stone() {
+    let mut state = state();
+    state.side_one.get_active().item = Items::LEFTOVERS;
+    let (s1, _) = state.get_all_options();
+    assert!(moves(&s1).iter().all(|c| matches!(c, MoveChoice::Move(_))));
+    state.side_one.get_active().item = Items::LAPRASITE; // someone else's stone
+    let (s1, _) = state.get_all_options();
+    assert!(moves(&s1).iter().all(|c| matches!(c, MoveChoice::Move(_))));
+}
+
+#[test]
+fn test_rr_stone_holder_switching_in_megas_on_its_first_move() {
+    let mut state = state();
+    state.side_one.get_active().item = Items::LEFTOVERS; // the lead cannot mega
+    let branches = generate_instructions_from_move_pair(
+        &mut state,
+        &MoveChoice::Switch(PokemonIndex::P1),
+        &MoveChoice::Move(M0),
+        false,
+    );
+    state.apply_instructions(&branches[0].instruction_list);
+    let (s1, _) = state.get_all_options();
+    assert!(moves(&s1).iter().all(|c| matches!(c, MoveChoice::MoveMega(_))));
+
+    let branches = generate_instructions_from_move_pair(
+        &mut state,
+        &MoveChoice::MoveMega(M0),
+        &MoveChoice::Move(M0),
+        false,
+    );
+    state.apply_instructions(&branches[0].instruction_list);
+    let l = state.side_one.get_active_immutable();
+    assert_eq!(PokemonName::LAPRASMEGA, l.id);
+    assert_eq!(
+        (136, 121, 146, 136, 101),
+        (l.attack, l.defense, l.special_attack, l.special_defense, l.speed)
+    );
+    assert_eq!((PokemonType::WATER, PokemonType::DRAGON), l.types);
+    assert_eq!(Abilities::LIQUIDVOICE, l.ability);
+}
+
+#[test]
+fn test_rr_changed_vanilla_mega() {
+    // RR's Houndoom-Mega: Dark Aura, 110 attack (vanilla: Solar Power, 90)
+    let m = PokemonName::HOUNDOOM
+        .mega_evolve_target(Items::HOUNDOOMINITE)
+        .unwrap();
+    assert_eq!(Abilities::DARKAURA, m.ability);
+    assert_eq!((75, 110, 90, 140, 90, 115), PokemonName::HOUNDOOMMEGA.base_stats());
+}
