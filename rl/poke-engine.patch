+            volatile_status: PokemonVolatileStatus::FLINCH,
+            ..
+        })
+    ))));
+
+    // Mold Breaker bypasses Unbothered (Taunt lands!).
+    let mut state = State::default();
+    state.side_one.get_active().ability = Abilities::MOLDBREAKER;
+    state.side_two.get_active().ability = Abilities::UNBOTHERED;
+    let ins = run_moves(&mut state, Choices::TAUNT, Choices::SPLASH);
+    assert!(ins[0]
+        .instruction_list
+        .contains(&Instruction::ApplyVolatileStatus(
