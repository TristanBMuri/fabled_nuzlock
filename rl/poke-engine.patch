+    // Blocks flinch (Fake Out deals damage, no FLINCH volatile).
+    let mut state = State::default();
+    state.side_two.get_active().ability = Abilities::UNBOTHERED;
+    state.side_two.get_active().hp = 200;
+    state.side_two.get_active().maxhp = 200;
+    let ins = run_moves(&mut state, Choices::FAKEOUT, Choices::SPLASH);
