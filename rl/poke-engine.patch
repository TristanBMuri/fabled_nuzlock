+/// Patch MOVES after `crate::rr_data::patch_moves`: adds Hidden Power Showdown IDs,
+/// all 27 new Radical Red moves, and fixes plain-data fields the generator could not express.
+pub fn patch_rr_moves(moves: &mut HashMap<Choices, Choice>) {
+    // All 16 Showdown-ID Hidden Power variants (60 BP in Gen 6+ / gen9rr)
+    let hp_types = [
+        (Choices::HIDDENPOWERBUG, PokemonType::BUG),
+        (Choices::HIDDENPOWERDARK, PokemonType::DARK),
+        (Choices::HIDDENPOWERDRAGON, PokemonType::DRAGON),
+        (Choices::HIDDENPOWERELECTRIC, PokemonType::ELECTRIC),
+        (Choices::HIDDENPOWERFIGHTING, PokemonType::FIGHTING),
+        (Choices::HIDDENPOWERFIRE, PokemonType::FIRE),
+        (Choices::HIDDENPOWERFLYING, PokemonType::FLYING),
+        (Choices::HIDDENPOWERGHOST, PokemonType::GHOST),
+        (Choices::HIDDENPOWERGRASS, PokemonType::GRASS),
+        (Choices::HIDDENPOWERGROUND, PokemonType::GROUND),
+        (Choices::HIDDENPOWERICE, PokemonType::ICE),
+        (Choices::HIDDENPOWERPOISON, PokemonType::POISON),
+        (Choices::HIDDENPOWERPSYCHIC, PokemonType::PSYCHIC),
+        (Choices::HIDDENPOWERROCK, PokemonType::ROCK),
+        (Choices::HIDDENPOWERSTEEL, PokemonType::STEEL),
+        (Choices::HIDDENPOWERWATER, PokemonType::WATER),
+    ];
+    for (move_id, move_type) in hp_types {
+        moves.insert(
+            move_id,
+            Choice {
+                move_id,
+                base_power: 60.0,
+                accuracy: 100.0,
+                category: MoveCategory::Special,
+                move_type,
+                flags: Flags {
+                    protect: true,
+                    ..Default::default()
+                },
+                ..Default::default()
+            },
+        );
+    }
+
+    // Fixes for existing moves whose target/flags/data rr_data.rs couldn't express cleanly
+    let atk_plus_1_self = Some(Boost {
+        target: MoveTarget::User,
+        boosts: StatBoosts {
+            attack: 1,
+            defense: 0,
+            special_attack: 0,
+            special_defense: 0,
+            speed: 0,
+            accuracy: 0,
+        },
+    });
+    if let Some(m) = moves.get_mut(&Choices::ACUPRESSURE) {
+        m.boost = atk_plus_1_self.clone();
+    }
+    if let Some(m) = moves.get_mut(&Choices::DOUBLETEAM) {
+        m.boost = atk_plus_1_self.clone();
+    }
+    if let Some(m) = moves.get_mut(&Choices::MINIMIZE) {
+        m.boost = atk_plus_1_self;
+        m.volatile_status = None;
+    }
+    if let Some(m) = moves.get_mut(&Choices::BATONPASS) {
+        m.flags.pivot = false;
+    }
+    if let Some(m) = moves.get_mut(&Choices::JAWLOCK) {
+        m.volatile_status = Some(VolatileStatus {
+            target: MoveTarget::Opponent,
+            volatile_status: PokemonVolatileStatus::TRAPPED,
+        });
+    }
+    if let Some(m) = moves.get_mut(&Choices::ROAROFTIME) {
+        m.flags.drag = true;
+    }
