+/// Steal all positive stat stages from defender and apply them to attacker before damage.
+/// Matches Showdown's `hitStepStealBoosts`.
+pub fn apply_steal_boosts(
+    state: &mut State,
+    attacking_side_ref: &SideReference,
+    instructions: &mut StateInstructions,
+) {
+    let defending_side_ref = attacking_side_ref.get_other_side();
+    let defending_side = state.get_side_immutable(&defending_side_ref);
+    let stats_to_steal = [
+        (PokemonBoostableStat::Attack, defending_side.attack_boost),
+        (PokemonBoostableStat::Defense, defending_side.defense_boost),
+        (
+            PokemonBoostableStat::SpecialAttack,
+            defending_side.special_attack_boost,
+        ),
+        (
+            PokemonBoostableStat::SpecialDefense,
+            defending_side.special_defense_boost,
+        ),
+        (PokemonBoostableStat::Speed, defending_side.speed_boost),
+        (
+            PokemonBoostableStat::Accuracy,
+            defending_side.accuracy_boost,
+        ),
+        (PokemonBoostableStat::Evasion, defending_side.evasion_boost),
+    ];
+
+    let mut stolen_any = false;
+    for (_, stage) in stats_to_steal {
+        if stage > 0 {
+            stolen_any = true;
+            break;
+        }
+    }
+    if !stolen_any {
+        return;
+    }
+
+    for (stat, stage) in stats_to_steal {
+        if stage > 0 {
+            let attacking_side = state.get_side(attacking_side_ref);
+            apply_boost_instruction(
+                attacking_side,
+                &stat,
+                &stage,
+                attacking_side_ref,
+                attacking_side_ref,
+                instructions,
+            );
+        }
+    }
+
+    let defending_side = state.get_side(&defending_side_ref);
+    for (stat, stage) in stats_to_steal {
+        if stage > 0 {
+            match stat {
+                PokemonBoostableStat::Attack => defending_side.attack_boost = 0,
+                PokemonBoostableStat::Defense => defending_side.defense_boost = 0,
+                PokemonBoostableStat::SpecialAttack => defending_side.special_attack_boost = 0,
+                PokemonBoostableStat::SpecialDefense => defending_side.special_defense_boost = 0,
+                PokemonBoostableStat::Speed => defending_side.speed_boost = 0,
+                PokemonBoostableStat::Accuracy => defending_side.accuracy_boost = 0,
+                PokemonBoostableStat::Evasion => defending_side.evasion_boost = 0,
+            }
+            instructions
+                .instruction_list
+                .push(Instruction::Boost(BoostInstruction {
+                    side_ref: defending_side_ref,
+                    stat,
+                    amount: -stage,
+                }));
+        }
+    }
+}
