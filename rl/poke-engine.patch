+/// Rollout / Ice Ball (Showdown's basePowerCallback): power doubles per hit done in this lock-in
+/// (ROLLOUT<n>), Defense Curl doubles it once more. Using it ends the lock; a hit before the
+/// 5th starts the next one, so a miss, Protect, an immunity or not getting to move ends it.
+fn rollout(
+    state: &mut State,
+    choice: &mut Choice,
+    side_ref: &SideReference,
+    incoming_instructions: &mut StateInstructions,
+) {
+    let side = state.get_side(side_ref);
+    let hits = side.rollout_hits();
+    if hits > 0 {
+        let volatile_status = ROLLOUT_HITS[hits - 1];
+        side.volatile_statuses.remove(&volatile_status);
+        incoming_instructions
+            .instruction_list
+            .push(Instruction::RemoveVolatileStatus(
+                RemoveVolatileStatusInstruction {
+                    side_ref: *side_ref,
+                    volatile_status,
+                },
+            ));
+    }
+    choice.base_power *= (1 << hits) as f32;
+    if side
+        .volatile_statuses
+        .contains(&PokemonVolatileStatus::DEFENSECURL)
+    {
+        choice.base_power *= 2.0;
+    }
+    if hits < 4 {
+        choice.volatile_status = Some(VolatileStatus {
+            target: MoveTarget::User,
+            volatile_status: ROLLOUT_HITS[hits],
+        });
+    }
+}
