+pub fn rr_modify_type_effectiveness(
+    attacker: &Pokemon,
+    defender: &Pokemon,
+    choice: &Choice,
+    type_eff: f32,
+) -> f32 {
+    if attacker.ability == Abilities::NEUTRALIZINGGAS
+        || defender.ability == Abilities::NEUTRALIZINGGAS
+    {
+        return type_eff;
+    }
+    if defender.ability == Abilities::TERASHELL
+        && !ignores_target_ability(attacker, choice, &defender.ability)
+        && choice.category != MoveCategory::Status
+        && matches!(
+            defender.id,
+            PokemonName::TERAPAGOS
+                | PokemonName::TERAPAGOSTERASTAL
+                | PokemonName::TERAPAGOSSTELLAR
+        )
+        && defender.hp >= defender.maxhp
+        && type_eff > 0.0
+    {
+        return 0.5;
+    }
+    type_eff
+}
