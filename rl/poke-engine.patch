+    // Turn 1: SideOne KOs SideTwo -> Phoenix Down heals to 50, clears status & boosts,
+    // and SideTwo still survives and attacks back (Tackle: 48).
+    let ins = run_moves(&mut state, Choices::TACKLE, Choices::TACKLE);
+    assert_eq!(ins.len(), 1);
+    let list = &ins[0].instruction_list;
+    assert!(list.contains(&Instruction::Heal(HealInstruction {
+        side_ref: SideReference::SideTwo,
+        heal_amount: 50,
+    })));
+    assert!(list.contains(&Instruction::ChangeStatus(ChangeStatusInstruction {
+        side_ref: SideReference::SideTwo,
+        pokemon_index: PokemonIndex::P0,
+        old_status: PokemonStatus::PARALYZE,
+        new_status: PokemonStatus::NONE,
+    })));
+    assert!(list.contains(&Instruction::Boost(BoostInstruction {
+        side_ref: SideReference::SideTwo,
+        stat: PokemonBoostableStat::Attack,
+        amount: -2,
+    })));
+    assert!(list.contains(&Instruction::Boost(BoostInstruction {
+        side_ref: SideReference::SideTwo,
+        stat: PokemonBoostableStat::Defense,
+        amount: 1,
+    })));
+    assert!(list.contains(&Instruction::ChangeAbility(ChangeAbilityInstruction {
+        side_ref: SideReference::SideTwo,
+        ability_change: Abilities::NONE as i16 - Abilities::PHOENIXDOWN as i16,
+    })));
+    // SideTwo survived and used Tackle!
+    assert!(list.contains(&Instruction::Damage(DamageInstruction {
+        side_ref: SideReference::SideOne,
+        damage_amount: 48,
+    })));
+
+    // Apply turn 1, switch out and back in, then KO again -> does NOT revive a second time.
+    state.apply_instructions(list);
+    assert_eq!(state.side_two.get_active().hp, 50);
+    assert_eq!(state.side_two.get_active().status, PokemonStatus::NONE);
+    assert_eq!(state.side_two.attack_boost, 0);
+    assert_eq!(state.side_two.defense_boost, 0);
+    state.side_two.get_active().hp = 10;
+    let ins2 = run_moves(&mut state, Choices::TACKLE, Choices::TACKLE);
+    assert_eq!(
+        ins2,
+        vec![StateInstructions {
+            percentage: 100.0,
+            instruction_list: vec![Instruction::Damage(DamageInstruction {
+                side_ref: SideReference::SideTwo,
+                damage_amount: 10,
+            })],
+        }]
+    );
+}
