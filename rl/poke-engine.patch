+#[test]
+fn test_rr_oranberry_berryjuice_switch_in_hazard_ripen_and_healblock() {
+    // Switching into Stealth Rock dropping HP to <= 50% triggers Berry Juice (+20) immediately
+    let mut s = State::default();
+    s.side_one.side_conditions.stealth_rock = 1;
+    s.side_one.pokemon[PokemonIndex::P1].types = (PokemonType::FIRE, PokemonType::FLYING); // 4x weak -> 50% SR dmg
+    s.side_one.pokemon[PokemonIndex::P1].maxhp = 40;
+    s.side_one.pokemon[PokemonIndex::P1].hp = 40;
+    s.side_one.pokemon[PokemonIndex::P1].item = Items::BERRYJUICE;
+    s.side_two
+        .get_active()
+        .replace_move(PokemonMoveIndex::M0, Choices::SPLASH);
+    let out = generate_instructions_from_move_pair(
+        &mut s,
+        &MoveChoice::Switch(PokemonIndex::P1),
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+        false,
+    );
+    s.apply_instructions(&out[0].instruction_list);
+    // 40 - 20 (SR) + 20 (Berry Juice) = 40, item consumed
+    assert_eq!(s.side_one.get_active().hp, 40);
+    assert_eq!(s.side_one.get_active().item, Items::NONE);
+
+    // Ripen doubles Oran Berry (+20), does NOT double Berry Juice (+20)
+    let mut r = State::default();
+    r.side_one.get_active().maxhp = 100;
+    r.side_one.get_active().hp = 40;
+    r.side_one.get_active().item = Items::ORANBERRY;
+    r.side_one.get_active().ability = Abilities::RIPEN;
+    let r_out = run_turn(&mut r, Choices::SPLASH, Choices::SPLASH);
+    r.apply_instructions(&r_out[0].instruction_list);
+    assert_eq!(r.side_one.get_active().hp, 60);
+    assert_eq!(r.side_one.get_active().item, Items::NONE);
+
+    // Heal Block prevents Oran Berry / Berry Juice consumption
+    let mut hb = State::default();
+    hb.side_one.get_active().maxhp = 100;
+    hb.side_one.get_active().hp = 40;
+    hb.side_one.get_active().item = Items::BERRYJUICE;
+    hb.side_one
+        .volatile_statuses
+        .insert(PokemonVolatileStatus::HEALBLOCK);
+    let hb_out = run_turn(&mut hb, Choices::SPLASH, Choices::SPLASH);
+    hb.apply_instructions(&hb_out[0].instruction_list);
+    assert_eq!(hb.side_one.get_active().hp, 40);
+    assert_eq!(hb.side_one.get_active().item, Items::BERRYJUICE);
+}
