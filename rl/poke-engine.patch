+fn make_mon(
+    id: PokemonName,
+    types: (PokemonType, PokemonType),
+    hp: i16,
+    maxhp: i16,
+    atk: i16,
+    def: i16,
+    spa: i16,
+    spd: i16,
+    spe: i16,
+    moves: &[Choices],
+) -> Pokemon {
+    let mut p = Pokemon::default();
+    p.id = id;
+    p.level = 50;
+    p.types = types;
+    p.base_types = types;
+    p.hp = hp;
+    p.maxhp = maxhp;
+    p.attack = atk;
+    p.defense = def;
+    p.special_attack = spa;
+    p.special_defense = spd;
+    p.speed = spe;
+    let slots = [
+        PokemonMoveIndex::M0,
+        PokemonMoveIndex::M1,
+        PokemonMoveIndex::M2,
+        PokemonMoveIndex::M3,
+    ];
+    for (i, slot) in slots.iter().enumerate() {
+        let mv = moves.get(i).copied().unwrap_or(Choices::NONE);
+        p.replace_move(*slot, mv);
+        if mv == Choices::NONE {
+            p.moves[slot].disabled = true;
+            p.moves[slot].pp = 0;
+        }
+    }
+    p
+}
