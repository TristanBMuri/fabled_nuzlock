+/// RR stat modifiers in damage calculation (Deep Sea Tooth, Deep Sea Scale, Explosion/Self-Destruct/Misty Explosion).
+pub fn rr_modify_damage_stats(
+    attacker: &Pokemon,
+    defender: &Pokemon,
+    choice: &Choice,
+    defending_stat: PokemonBoostableStat,
+    attacking_final: &mut i16,
+    crit_attacking: &mut i16,
+    defending_final: &mut i16,
+    crit_defending: &mut i16,
+) {
+    if attacker.item == Items::DEEPSEATOOTH
+        && attacker.id == PokemonName::CLAMPERL
+        && choice.category == MoveCategory::Special
+    {
+        *attacking_final = attacking_final.saturating_mul(2);
+        *crit_attacking = crit_attacking.saturating_mul(2);
+    }
+    if defender.item == Items::DEEPSEASCALE
+        && defender.id == PokemonName::CLAMPERL
+        && defending_stat == PokemonBoostableStat::SpecialDefense
+    {
+        *defending_final = defending_final.saturating_mul(2);
+        *crit_defending = crit_defending.saturating_mul(2);
+    }
+    if (matches!(choice.move_id, Choices::EXPLOSION | Choices::SELFDESTRUCT)
+        && defending_stat == PokemonBoostableStat::Defense)
+        || (choice.move_id == Choices::MISTYEXPLOSION
+            && defending_stat == PokemonBoostableStat::SpecialDefense)
+    {
+        *defending_final = (*defending_final / 2).max(1);
+        *crit_defending = (*crit_defending / 2).max(1);
+    }
+}
+
+/// RR speed multiplier from items (Up-Grade 1.5x for Porygon-Z, Leek Stick 1.5x for Farfetch'd).
+pub fn rr_item_speed_multiplier(pkmn: &Pokemon) -> f32 {
+    match pkmn.item {
+        Items::UPGRADE if pkmn.id == PokemonName::PORYGONZ => 1.5,
+        Items::LEEKSTICK
+            if matches!(pkmn.id, PokemonName::FARFETCHD | PokemonName::FARFETCHDGALAR) =>
+        {
+            1.5
+        }
+        _ => 1.0,
+    }
+}
+
+/// RR `item_modify_attack_being_used` hooks.
+pub fn rr_item_modify_attack_being_used(
+    state: &State,
+    attacking_choice: &mut Choice,
+    attacking_side_ref: &SideReference,
+) {
+    let attacking_pkmn = state
+        .get_side_immutable(attacking_side_ref)
+        .get_active_immutable();
+    match attacking_pkmn.item {
+        Items::ELECTIRIZER => {
+            if attacking_pkmn.id == PokemonName::ELECTIVIRE
+                && attacking_choice.move_type == PokemonType::FIGHTING
+            {
+                attacking_choice.base_power *= 1.5;
+            }
+        }
+        Items::BURNTSEED => {
+            if attacking_pkmn.id == PokemonName::SUNFLORA
+                && attacking_choice.move_type == PokemonType::FIRE
+            {
+                attacking_choice.base_power *= 1.5;
+            }
+        }
+        Items::REAPERCLOTH => {
+            if attacking_pkmn.id == PokemonName::DUSKNOIR {
+                attacking_choice.accuracy = 100.0;
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Whether a move ignores accuracy/evasion checks (`accuracy: true`) due to RR items/moves.
+pub fn rr_move_cannot_miss(attacker: &Pokemon, choice: &Choice, weather: Weather) -> bool {
+    if attacker.item == Items::REAPERCLOTH && attacker.id == PokemonName::DUSKNOIR {
+        return true;
+    }
+    match choice.move_id {
+        Choices::WILLOWISP if attacker.has_type(&PokemonType::FIRE) => true,
+        Choices::THUNDERWAVE if attacker.has_type(&PokemonType::ELECTRIC) => true,
+        Choices::SPRINGTIDESTORM if matches!(weather, Weather::RAIN | Weather::HEAVYRAIN) => true,
+        _ => false,
+    }
+}
+
+/// RR `after_damage_hit` hooks: target thawing, Sparkly Swirl, Bubble Blast, Death Ball,
+/// Heat Up, Ironclad Impact, Polar Flare, and Magmarizer.
+pub fn rr_after_damage_hit(
+    state: &mut State,
+    choice: &Choice,
+    attacking_side_ref: &SideReference,
+    instructions: &mut StateInstructions,
+    hit_sub: bool,
+) {
+    let defending_side_ref = attacking_side_ref.get_other_side();
+
+    // Move-specific after-hit effects that happen regardless of whether defender fainted
+    match choice.move_id {
+        Choices::SPARKLYSWIRL => {
+            let attacking_side = state.get_side(attacking_side_ref);
+            for pkmn_index in pokemon_index_iter() {
+                if attacking_side.pokemon[pkmn_index].status != PokemonStatus::NONE {
+                    add_remove_status_instructions(
+                        instructions,
+                        pkmn_index,
+                        *attacking_side_ref,
+                        attacking_side,
+                    );
+                }
+            }
+        }
+        Choices::BUBBLEBLAST => {
+            let (attacking_side, defending_side) = state.get_both_sides(attacking_side_ref);
+            let attacker_alive = attacking_side.get_active_immutable().hp > 0;
+            let defender = defending_side.get_active();
+            if attacker_alive && !hit_sub && defender.item_can_be_removed() && defender.item != Items::NONE {
+                instructions
+                    .instruction_list
+                    .push(Instruction::ChangeItem(ChangeItemInstruction {
+                        side_ref: defending_side_ref,
+                        current_item: defender.item,
+                        new_item: Items::NONE,
+                    }));
+                defender.item = Items::NONE;
+            }
+        }
+        Choices::DEATHBALL => {
+            let (attacking_side, defending_side) = state.get_both_sides(attacking_side_ref);
+            if !hit_sub && defending_side.get_active_immutable().hp <= 0 {
+                let attacker = attacking_side.get_active();
+                let dmg = cmp::min((attacker.maxhp / 3).max(1), attacker.hp);
+                if dmg > 0 {
+                    attacker.hp -= dmg;
+                    instructions
+                        .instruction_list
+                        .push(Instruction::Damage(DamageInstruction {
+                            side_ref: *attacking_side_ref,
+                            damage_amount: dmg,
+                        }));
+                }
+            }
+        }
+        Choices::HEATUP => {
+            let attacking_side = state.get_side(attacking_side_ref);
+            let old_types = attacking_side.get_active_immutable().types;
+            let fire_only = (PokemonType::FIRE, PokemonType::TYPELESS);
+            if old_types != fire_only {
+                if !attacking_side
+                    .volatile_statuses
+                    .contains(&PokemonVolatileStatus::TYPECHANGE)
+                {
+                    attacking_side
+                        .volatile_statuses
+                        .insert(PokemonVolatileStatus::TYPECHANGE);
+                    instructions
+                        .instruction_list
+                        .push(Instruction::ApplyVolatileStatus(
+                            ApplyVolatileStatusInstruction {
+                                side_ref: *attacking_side_ref,
+                                volatile_status: PokemonVolatileStatus::TYPECHANGE,
+                            },
+                        ));
+                }
+                attacking_side.get_active().types = fire_only;
+                instructions
+                    .instruction_list
+                    .push(Instruction::ChangeType(ChangeType {
+                        side_ref: *attacking_side_ref,
+                        new_types: fire_only,
+                        old_types,
+                    }));
+            }
+        }
+        Choices::IRONCLADIMPACT if !hit_sub => {
+            let defending_side = state.get_side(&defending_side_ref);
+            if defending_side.get_active_immutable().hp > 0 {
+                let highest = defending_side.calculate_highest_stat();
+                apply_boost_instruction(
+                    defending_side,
+                    &highest,
+                    &-1,
+                    attacking_side_ref,
+                    &defending_side_ref,
+                    instructions,
+                );
+            }
+        }
+        Choices::POLARFLARE => {
+            let cur_id = state
+                .get_side_immutable(attacking_side_ref)
+                .get_active_immutable()
+                .id;
+            if cur_id == PokemonName::RAMNAROK {
+                apply_forme_change_with_species_info(
+                    state,
+                    attacking_side_ref,
+                    PokemonName::RAMNAROKRADIANT,
+                    instructions,
+                );
+            } else if cur_id == PokemonName::RAMNAROKRADIANT {
+                apply_forme_change_with_species_info(
+                    state,
+                    attacking_side_ref,
+                    PokemonName::RAMNAROK,
+                    instructions,
+                );
+            }
+        }
+        _ => {}
+    }
+
+    if hit_sub {
+        return;
+    }
+    let (attacking_side, defending_side) = state.get_both_sides(attacking_side_ref);
+    let attacker = attacking_side.get_active_immutable();
+    let defender = defending_side.get_active_immutable();
+    if defender.hp <= 0 {
+        return;
+    }
+
+    // Fire-type damaging moves and thawsTarget moves cure Frostbite (frz)
+    if defender.status == PokemonStatus::FREEZE && thaws_target(choice) {
+        let def_idx = defending_side.active_index;
+        add_remove_status_instructions(instructions, def_idx, defending_side_ref, defending_side);
+    }
+
+    // Magmarizer on Magmortar: Fire-type damaging hit applies Tar Shot + -1 Spe
+    if attacker.item == Items::MAGMARIZER
+        && attacker.id == PokemonName::MAGMORTAR
+        && choice.move_type == PokemonType::FIRE
+        && choice.category != MoveCategory::Status
+    {
+        if !defending_side
+            .volatile_statuses
+            .contains(&PokemonVolatileStatus::TARSHOT)
+            && defending_side.speed_boost != -6
+        {
+            defending_side
+                .volatile_statuses
+                .insert(PokemonVolatileStatus::TARSHOT);
+            instructions
+                .instruction_list
+                .push(Instruction::ApplyVolatileStatus(
+                    ApplyVolatileStatusInstruction {
+                        side_ref: defending_side_ref,
+                        volatile_status: PokemonVolatileStatus::TARSHOT,
+                    },
+                ));
+            apply_boost_instruction(
+                defending_side,
+                &PokemonBoostableStat::Speed,
+                &-1,
+                attacking_side_ref,
+                &defending_side_ref,
+                instructions,
+            );
+        }
+    }
+}
+
+/// Flat-HP healing items (Oran Berry: 10 HP, Berry Juice: 20 HP) at <= 1/2 max HP.
+pub fn rr_try_flat_heal_item(
+    side_ref: &SideReference,
+    side: &mut Side,
+    instructions: &mut StateInstructions,
+) {
+    if side
+        .volatile_statuses
+        .contains(&PokemonVolatileStatus::HEALBLOCK)
+    {
+        return;
+    }
+    let active = side.get_active();
+    if active.hp <= 0 || active.hp > active.maxhp / 2 {
+        return;
+    }
+    let (item, heal_cap) = match active.item {
+        Items::ORANBERRY => {
+            let cap = if active.ability == Abilities::RIPEN {
+                20i16
+            } else {
+                10i16
+            };
+            (Items::ORANBERRY, cap)
+        }
+        Items::BERRYJUICE => (Items::BERRYJUICE, 20i16),
+        _ => return,
+    };
+    let heal_amount = cmp::min(heal_cap, active.maxhp - active.hp);
+    if heal_amount > 0 {
+        instructions
+            .instruction_list
+            .push(Instruction::Heal(HealInstruction {
+                side_ref: *side_ref,
+                heal_amount,
+            }));
+        active.hp += heal_amount;
+    }
+    instructions
+        .instruction_list
+        .push(Instruction::ChangeItem(ChangeItemInstruction {
+            side_ref: *side_ref,
+            current_item: item,
+            new_item: Items::NONE,
+        }));
+    active.item = Items::NONE;
+}
+
+/// Weather duration for weather-extending rocks (Smooth/Heat/Damp/Icy Rock -> 8 turns).
+pub fn rr_weather_turns(item: Items, weather: Weather) -> i8 {
+    match (item, weather) {
+        (Items::SMOOTHROCK, Weather::SAND)
+        | (Items::HEATROCK, Weather::SUN)
+        | (Items::DAMPROCK, Weather::RAIN)
+        | (Items::ICYROCK, Weather::HAIL | Weather::SNOW) => 8,
+        _ => 5,
+    }
+}
+
+/// Helper to perform a Primal/Orb forme change on switch-in (Dialga-Primal, Eternatus-Eternamax, Ampharos-Fabio).
+fn apply_primal_forme_change(
+    state: &mut State,
+    side_ref: &SideReference,
+    new_id: PokemonName,
+    new_types: (PokemonType, PokemonType),
+    new_ability_str: &str,
+    instructions: &mut StateInstructions,
+) {
+    let active = state.get_side(side_ref).get_active();
+    if active.id == new_id {
+        return;
+    }
+    instructions
+        .instruction_list
+        .push(Instruction::FormeChange(FormeChangeInstruction {
+            side_ref: *side_ref,
+            name_change: new_id as i16 - active.id as i16,
+        }));
+    active.id = new_id;
+    active.recalculate_stats(side_ref, instructions);
+
+    if let Ok(new_abil) = Abilities::from_str(new_ability_str) {
+        if new_abil != Abilities::NONE {
+            if new_abil != active.ability {
+                instructions
+                    .instruction_list
+                    .push(Instruction::ChangeAbility(ChangeAbilityInstruction {
+                        side_ref: *side_ref,
+                        ability_change: new_abil as i16 - active.ability as i16,
+                    }));
+                active.ability = new_abil;
+            }
+            if new_abil != active.base_ability {
+                instructions
+                    .instruction_list
+                    .push(Instruction::ChangeBaseAbility(ChangeAbilityInstruction {
+                        side_ref: *side_ref,
+                        ability_change: new_abil as i16 - active.base_ability as i16,
+                    }));
+                active.base_ability = new_abil;
+            }
+        }
+    }
+
+    if new_types != active.types {
+        instructions
+            .instruction_list
+            .push(Instruction::ChangeType(ChangeType {
+                side_ref: *side_ref,
+                new_types,
+                old_types: active.types,
+            }));
+        active.types = new_types;
+    }
+}
+
+/// RR `item_on_switch_in`: weather rocks + Primal/Orb switch-in transformations.
+pub fn rr_item_on_switch_in(
+    state: &mut State,
+    side_ref: &SideReference,
+    instructions: &mut StateInstructions,
+) {
+    let (item, ability, id) = {
+        let pkmn = state.get_side_immutable(side_ref).get_active_immutable();
+        (pkmn.item, pkmn.ability, pkmn.id)
+    };
+
+    match (item, id) {
+        (Items::ADAMANTORB, PokemonName::DIALGA) => {
+            apply_primal_forme_change(
+                state,
+                side_ref,
+                PokemonName::DIALGAPRIMAL,
+                (PokemonType::STEEL, PokemonType::DRAGON),
+                "primalarmor",
+                instructions,
+            );
+        }
+        (Items::ETERNAMAXORB, PokemonName::ETERNATUS) => {
+            apply_primal_forme_change(
+                state,
+                side_ref,
+                PokemonName::ETERNATUSETERNAMAX,
+                (PokemonType::POISON, PokemonType::DRAGON),
+                "levitate",
+                instructions,
+            );
+        }
+        (Items::COUNCILORB, PokemonName::AMPHAROS) => {
+            apply_primal_forme_change(
+                state,
+                side_ref,
+                PokemonName::AMPHAROSFABIO,
+                (PokemonType::ELECTRIC, PokemonType::FLYING),
+                "assholesinsufferableness",
+                instructions,
+            );
+        }
+        _ => {}
+    }
+
+    let should_extend = match (item, ability, state.weather.weather_type) {
+        (Items::SMOOTHROCK, Abilities::SANDSTREAM, Weather::SAND)
+        | (Items::HEATROCK, Abilities::DROUGHT, Weather::SUN)
+        | (Items::DAMPROCK, Abilities::DRIZZLE, Weather::RAIN)
+        | (Items::ICYROCK, Abilities::SNOWWARNING, Weather::HAIL | Weather::SNOW) => {
+            state.weather.turns_remaining == 5
+        }
+        _ => false,
+    };
+    if should_extend {
+        let w = state.weather.weather_type;
+        instructions
+            .instruction_list
+            .push(Instruction::ChangeWeather(ChangeWeather {
+                new_weather: w,
+                new_weather_turns_remaining: 8,
+                previous_weather: w,
+                previous_weather_turns_remaining: 5,
+            }));
+        state.weather.turns_remaining = 8;
+    }
+
+    // Trigger Oran Berry / Berry Juice if switching in (e.g. after hazard chip) leaves active <= 50% HP
+    let side = state.get_side(side_ref);
+    rr_try_flat_heal_item(side_ref, side, instructions);
+}
