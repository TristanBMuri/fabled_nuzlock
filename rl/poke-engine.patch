+#[test]
+fn test_rr_darkhole_bypasses_substitute_and_sleeps() {
+    let mut state = State::default();
+    state.side_one.get_active().types = (PokemonType::DARK, PokemonType::TYPELESS);
+    state.side_two.get_active().hp = 400;
+    state.side_two.get_active().maxhp = 400;
+    state
+        .side_two
+        .volatile_statuses
+        .insert(PokemonVolatileStatus::SUBSTITUTE);
+    state.side_two.substitute_health = 100;
+
+    let out = run_turn(&mut state, Choices::DARKHOLE, Choices::SPLASH);
+    // 60% no sleep, 40% sleep
+    assert_eq!(out.len(), 2);
+    let sleep_branch = out
+        .iter()
+        .find(|si| {
+            si.instruction_list.iter().any(|i| {
+                matches!(
+                    i,
+                    Instruction::ChangeStatus(ChangeStatusInstruction {
+                        side_ref: SideReference::SideTwo,
+                        new_status: PokemonStatus::SLEEP,
+                        ..
+                    })
+                )
+            })
+        })
+        .expect("Dark Hole should have a sleep branch through Substitute");
+    assert!((sleep_branch.percentage - 40.0).abs() < 0.01);
+    // Damage hits side two HP directly, not substitute
+    assert!(sleep_branch
+        .instruction_list
+        .iter()
+        .any(|i| matches!(i, Instruction::Damage(DamageInstruction { side_ref: SideReference::SideTwo, .. }))));
+    assert!(!sleep_branch
+        .instruction_list
+        .iter()
+        .any(|i| matches!(i, Instruction::DamageSubstitute(_))));
+}
+
+#[test]
+fn test_rr_soulrobbery_steals_boosts_before_damage_and_bypasses_sub() {
+    let mut state = State::default();
+    state.side_one.get_active().types = (PokemonType::PSYCHIC, PokemonType::TYPELESS);
+    state.side_two.get_active().hp = 500;
+    state.side_two.get_active().maxhp = 500;
+    state.side_two.special_attack_boost = 2;
+    state.side_two.special_defense_boost = 2;
+    state
+        .side_two
+        .volatile_statuses
+        .insert(PokemonVolatileStatus::SUBSTITUTE);
+    state.side_two.substitute_health = 100;
+
+    let out = run_turn(&mut state, Choices::SOULROBBERY, Choices::SPLASH);
+    assert_eq!(out.len(), 1);
+    let ins = &out[0].instruction_list;
+
+    // Steals +2 SpA and +2 SpD to side one, clears them on side two
+    assert!(ins.contains(&Instruction::Boost(BoostInstruction {
+        side_ref: SideReference::SideOne,
+        stat: PokemonBoostableStat::SpecialAttack,
+        amount: 2,
+    })));
+    assert!(ins.contains(&Instruction::Boost(BoostInstruction {
+        side_ref: SideReference::SideTwo,
+        stat: PokemonBoostableStat::SpecialDefense,
+        amount: -2,
+    })));
+
+    // Damage reflects +2 SpA on attacker and 0 SpD on defender (2x higher than unboosted)
+    let dmg = ins
+        .iter()
+        .find_map(|i| match i {
+            Instruction::Damage(d) if d.side_ref == SideReference::SideTwo => Some(d.damage_amount),
+            _ => None,
+        })
+        .unwrap();
+    // Lv100, 100 BP, 200 boosted SpA vs 100 SpD, 1.5x STAB -> ~235
+    assert!(dmg >= 220 && dmg <= 255, "expected boosted dmg ~235, got {}", dmg);
+
+    // Dark-type target is immune: must NOT steal boosts
+    let mut dark_state = State::default();
+    dark_state.side_two.get_active().types = (PokemonType::DARK, PokemonType::TYPELESS);
+    dark_state.side_two.attack_boost = 2;
+    let dark_out = run_turn(&mut dark_state, Choices::SOULROBBERY, Choices::SPLASH);
+    assert_eq!(dark_out.len(), 1);
+    assert!(dark_out[0].instruction_list.is_empty());
+}
