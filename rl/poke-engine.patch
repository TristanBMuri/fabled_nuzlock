+pub fn rr_check_emergency_exit(
+    state: &mut State,
+    sides: [&SideReference; 2],
+    start_hp: (i16, i16),
+    instructions: &mut StateInstructions,
+) {
+    if state.side_one.force_switch || state.side_two.force_switch {
+        return;
+    }
+    for side_ref in sides {
+        let orig_hp = match side_ref {
+            SideReference::SideOne => start_hp.0,
+            SideReference::SideTwo => start_hp.1,
+        };
+        let other_ngas = state
+            .get_side_immutable(&side_ref.get_other_side())
+            .get_active_immutable()
+            .ability
+            == Abilities::NEUTRALIZINGGAS;
+        if other_ngas {
+            continue;
+        }
+        let side = state.get_side(side_ref);
+        let pkmn = side.get_active_immutable();
+        if pkmn.ability == Abilities::EMERGENCYEXIT
+            && pkmn.hp > 0
+            && pkmn.hp <= pkmn.maxhp / 2
+            && orig_hp > pkmn.maxhp / 2
+            && side.visible_alive_pkmn() > 1
+        {
+            side.force_switch = true;
+            instructions.instruction_list.push(match side_ref {
+                SideReference::SideOne => Instruction::ToggleSideOneForceSwitch,
+                SideReference::SideTwo => Instruction::ToggleSideTwoForceSwitch,
+            });
+            break;
+        }
+    }
+}
