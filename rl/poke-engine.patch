+pub fn rr_the_look_blocks_move(
+    state: &State,
+    choice: &Choice,
+    attacking_side_ref: &SideReference,
+) -> bool {
+    let (attacking_side, defending_side) = state.get_both_sides_immutable(attacking_side_ref);
+    let defender = defending_side.get_active_immutable();
+    let attacker = attacking_side.get_active_immutable();
+    if defender.ability != Abilities::THELOOK
+        || attacker.ability == Abilities::NEUTRALIZINGGAS
+        || choice.move_id == Choices::STRUGGLE
+    {
+        return false;
+    }
+    matches!(attacking_side.last_used_move, LastUsedMove::Move(idx) if idx == choice.move_index)
+}
+
+pub fn rr_filter_options_for_the_look(
+    side: &Side,
+    opponent_active: &Pokemon,
+    options: &mut Vec<MoveChoice>,
+) {
+    if opponent_active.ability != Abilities::THELOOK
+        || side.get_active_immutable().ability == Abilities::NEUTRALIZINGGAS
+    {
+        return;
+    }
+    if let LastUsedMove::Move(last_idx) = side.last_used_move {
+        if side.get_active_immutable().moves[&last_idx].id != Choices::STRUGGLE {
+            options.retain(|opt| {
+                !matches!(
+                    opt,
+                    MoveChoice::Move(i) | MoveChoice::MoveTera(i) | MoveChoice::MoveMega(i)
+                        if *i == last_idx
+                )
+            });
+        }
+    }
+}
+
+pub fn rr_always_hits(state: &State, choice: &Choice, attacking_side_ref: &SideReference) -> bool {
+    let (attacking_side, defending_side) = state.get_both_sides_immutable(attacking_side_ref);
+    let attacker = attacking_side.get_active_immutable();
+    let defender = defending_side.get_active_immutable();
+    if defender.ability == Abilities::NEUTRALIZINGGAS {
+        return false;
+    }
+    attacker.ability == Abilities::FATALPRECISION
+        && type_effectiveness_modifier(&choice.move_type, defender) > 1.0
+}
+
+pub fn is_oraoraoraora_hit(
+    state: &State,
+    attacking_side_ref: &SideReference,
+    choice: &Choice,
+) -> bool {
+    let (attacking_side, defending_side) = state.get_both_sides_immutable(attacking_side_ref);
+    let attacker = attacking_side.get_active_immutable();
+    if defending_side.get_active_immutable().ability == Abilities::NEUTRALIZINGGAS {
+        return false;
+    }
+    attacker.ability == Abilities::ORAORAORAORA
+        && choice.category != MoveCategory::Status
+        && choice.flags.punch
+        && !choice.flags.charge
+        && choice.multi_hit() == MultiHitMove::None
+        && choice.multi_accuracy() == MultiAccuracyMove::None
+        && !matches!(
+            choice.move_id,
+            Choices::EXPLOSION | Choices::SELFDESTRUCT | Choices::MISTYEXPLOSION
+        )
+}
+
+pub fn oraoraoraora_second_hit_damage(
+    state: &State,
+    attacking_side_ref: &SideReference,
+    choice: &Choice,
+    fallback_damage: i16,
+) -> i16 {
+    let Some((base, modifier, crit_base, crit_modifier)) =
+        damage_parts(state, attacking_side_ref, choice)
+    else {
+        return fallback_damage / 2;
+    };
+    let (_, defending_side) = state.get_both_sides_immutable(attacking_side_ref);
+    let defender = defending_side.get_active_immutable();
+    let use_crit = choice.move_id.guaranteed_crit()
+        && defender.ability != Abilities::BATTLEARMOR
+        && defender.ability != Abilities::SHELLARMOR;
+    let (b, m) = if use_crit {
+        (crit_base, crit_modifier)
+    } else {
+        (base, modifier)
+    };
+    // Showdown: baseDamage = this.battle.modify(baseDamage, 0.5) before randomizer
+    let halved_base = (((b as i32) * 2048 + 2047) / 4096) as f32;
+    let mut sum = 0.0f32;
+    for r in 0..16 {
+        let d = ((halved_base * (85 + r) as f32 / 100.0).floor() * m).floor() as i16;
+        let d = if m > 0.0 { d.max(1) } else { d };
+        sum += d as f32;
+    }
+    (sum / 16.0).round() as i16
+}
+
+fn clear_all_boosts(
+    side: &mut Side,
+    side_ref: &SideReference,
+    instructions: &mut StateInstructions,
+) {
+    let fields: [(PokemonBoostableStat, i8); 7] = [
+        (PokemonBoostableStat::Attack, side.attack_boost),
+        (PokemonBoostableStat::Defense, side.defense_boost),
+        (PokemonBoostableStat::SpecialAttack, side.special_attack_boost),
+        (
+            PokemonBoostableStat::SpecialDefense,
+            side.special_defense_boost,
+        ),
+        (PokemonBoostableStat::Speed, side.speed_boost),
+        (PokemonBoostableStat::Accuracy, side.accuracy_boost),
+        (PokemonBoostableStat::Evasion, side.evasion_boost),
+    ];
+    for (stat, val) in fields {
+        if val != 0 {
+            instructions
+                .instruction_list
+                .push(Instruction::Boost(BoostInstruction {
+                    side_ref: *side_ref,
+                    stat,
+                    amount: -val,
+                }));
+        }
+    }
+    side.attack_boost = 0;
+    side.defense_boost = 0;
+    side.special_attack_boost = 0;
+    side.special_defense_boost = 0;
+    side.speed_boost = 0;
+    side.accuracy_boost = 0;
+    side.evasion_boost = 0;
+}
+
+pub fn try_phoenix_down_on_side(
+    side: &mut Side,
+    side_ref: &SideReference,
+    instructions: &mut StateInstructions,
+) -> bool {
+    let active_index = side.active_index;
+    let pkmn = side.get_active();
+    if pkmn.hp != 0 || pkmn.ability != Abilities::PHOENIXDOWN {
+        return false;
+    }
+    let heal_amount = pkmn.maxhp / 2;
+    if heal_amount > 0 {
+        pkmn.hp += heal_amount;
+        instructions
+            .instruction_list
+            .push(Instruction::Heal(HealInstruction {
+                side_ref: *side_ref,
+                heal_amount,
+            }));
+    }
+    let old_ability = pkmn.ability;
+    let old_base_ability = pkmn.base_ability;
+    pkmn.ability = Abilities::NONE;
+    instructions
+        .instruction_list
+        .push(Instruction::ChangeAbility(ChangeAbilityInstruction {
+            side_ref: *side_ref,
+            ability_change: Abilities::NONE as i16 - old_ability as i16,
+        }));
+    if old_base_ability != Abilities::NONE {
+        pkmn.base_ability = Abilities::NONE;
+        instructions
+            .instruction_list
+            .push(Instruction::ChangeBaseAbility(ChangeAbilityInstruction {
+                side_ref: *side_ref,
+                ability_change: Abilities::NONE as i16 - old_base_ability as i16,
+            }));
+    }
+    if side.get_active_immutable().status != PokemonStatus::NONE {
+        add_remove_status_instructions(instructions, active_index, *side_ref, side);
+    }
+    clear_all_boosts(side, side_ref, instructions);
+    true
+}
