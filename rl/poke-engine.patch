+#![cfg(feature = "rr")]
+
+use poke_engine::choices::{Choices, MoveCategory, MOVES};
+use poke_engine::engine::abilities::Abilities;
+use poke_engine::engine::damage_calc::{calculate_damage, DamageRolls};
+use poke_engine::engine::generate_instructions::generate_instructions_from_move_pair;
+use poke_engine::engine::items::Items;
+use poke_engine::engine::state::{MoveChoice, PokemonVolatileStatus, Weather};
+use poke_engine::instruction::{
+    ApplyVolatileStatusInstruction, BoostInstruction, ChangeItemInstruction, ChangeStatusInstruction,
+    ChangeWeather, DamageInstruction, HealInstruction, Instruction, StateInstructions,
+};
+use poke_engine::pokemon::PokemonName;
+use poke_engine::state::{
+    PokemonBoostableStat, PokemonIndex, PokemonMoveIndex, PokemonStatus, PokemonType,
+    SideReference, State,
+};
+use std::str::FromStr;
+
+fn run_turn(
+    state: &mut State,
+    m1: Choices,
+    m2: Choices,
+) -> Vec<StateInstructions> {
+    state
+        .side_one
+        .get_active()
+        .replace_move(PokemonMoveIndex::M0, m1);
+    state
+        .side_two
+        .get_active()
+        .replace_move(PokemonMoveIndex::M0, m2);
+    let before = format!("{:?}", state);
+    let out = generate_instructions_from_move_pair(
+        state,
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+        false,
+    );
+    assert_eq!(before, format!("{:?}", state), "state was not cleanly reversed");
+    out
+}
+
+#[test]
+fn test_rr_aquafang_data_and_damage() {
+    let mv = MOVES.get(&Choices::AQUAFANG).expect("aquafang in MOVES");
+    assert_eq!(mv.base_power, 80.0);
+    assert_eq!(mv.accuracy, 100.0);
+    assert_eq!(mv.category, MoveCategory::Physical);
+    assert_eq!(mv.move_type, PokemonType::WATER);
+    assert!(mv.flags.bite && mv.flags.contact && mv.flags.protect);
+    assert_eq!(Choices::from_str("aquafang").unwrap(), Choices::AQUAFANG);
+
+    // Strong Jaw boosts Aqua Fang by 1.5x (80 -> 120 BP)
+    let mut state = State::default();
+    state.side_one.get_active().ability = Abilities::STRONGJAW;
+    state.side_two.get_active().hp = 500;
+    state.side_two.get_active().maxhp = 500;
+    let out = run_turn(&mut state, Choices::AQUAFANG, Choices::SPLASH);
+    assert_eq!(out.len(), 1);
+    let dmg = out[0]
+        .instruction_list
+        .iter()
+        .find_map(|i| match i {
+            Instruction::Damage(d) if d.side_ref == SideReference::SideTwo => Some(d.damage_amount),
+            _ => None,
+        })
+        .unwrap();
+    // Lv 100, 100 Atk vs 100 Def, 120 BP (80 * 1.5 Strong Jaw), no STAB -> avg ~95
+    assert!(dmg >= 90 && dmg <= 105, "expected ~95 dmg, got {}", dmg);
+}
+
+#[test]
+fn test_rr_dracobarrage_hits_fairy_switches_category_and_recoils() {
+    let mut state = State::default();
+    state.side_one.get_active().types = (PokemonType::DRAGON, PokemonType::TYPELESS);
+    state.side_one.get_active().attack = 200;
+    state.side_one.get_active().special_attack = 100;
+    state.side_one.get_active().hp = 300;
+    state.side_one.get_active().maxhp = 300;
+
+    // Fairy defender with high SpD, lower Def -> physical hits harder & is NOT immune
+    state.side_two.get_active().types = (PokemonType::FAIRY, PokemonType::TYPELESS);
+    state.side_two.get_active().defense = 100;
+    state.side_two.get_active().special_defense = 250;
+    state.side_two.get_active().hp = 400;
+    state.side_two.get_active().maxhp = 400;
+
+    let out = run_turn(&mut state, Choices::DRACOBARRAGE, Choices::SPLASH);
+    assert_eq!(out.len(), 1);
+
+    let dmg_s2 = out[0]
+        .instruction_list
+        .iter()
+        .find_map(|i| match i {
+            Instruction::Damage(d) if d.side_ref == SideReference::SideTwo => Some(d.damage_amount),
+            _ => None,
+        })
+        .expect("Draco Barrage must hit Fairy target");
+    // Lv100, 100 BP, 200 Atk vs 100 Def, 1.5x STAB, 1x vs Fairy -> base 170, avg ~235
+    assert!(dmg_s2 >= 220 && dmg_s2 <= 255, "expected ~235 physical dmg, got {}", dmg_s2);
+
+    let recoil_s1 = out[0]
+        .instruction_list
+        .iter()
+        .find_map(|i| match i {
+            Instruction::Damage(d) if d.side_ref == SideReference::SideOne => Some(d.damage_amount),
+            _ => None,
+        })
+        .expect("Draco Barrage must deal 1/3 recoil");
+    assert_eq!(recoil_s1, (dmg_s2 as f32 / 3.0) as i16);
+}
