+#[test]
+fn test_angershell_multihit_branching_and_single_trigger() {
+    // Klawf (Anger Shell, Rock, 91/91 HP, 83 Def) switching into Ambipom (Technician, 67 Atk)
+    // using Arm Thrust (25 BP Fighting, 2-5 hits -> ~16 dmg/hit):
+    // 2 hits (35%) leaves 59/91 (> 50%) -> no Anger Shell; 3/4/5 hits (65%) drops <= 45 -> +1 Atk/SpA/Spe, -1 Def/SpD once.
+    let mut state = State::default();
+    {
+        let klawf = &mut state.side_one.pokemon[PokemonIndex::P1];
+        klawf.id = PokemonName::KLAWF;
+        klawf.level = 28;
+        klawf.types = (PokemonType::ROCK, PokemonType::TYPELESS);
+        klawf.hp = 91;
+        klawf.maxhp = 91;
+        klawf.defense = 83;
+        klawf.ability = Abilities::ANGERSHELL;
+    }
+    {
+        let ambipom = state.side_two.get_active();
+        ambipom.id = PokemonName::AMBIPOM;
+        ambipom.level = 27;
+        ambipom.types = (PokemonType::NORMAL, PokemonType::TYPELESS);
+        ambipom.attack = 67;
+        ambipom.ability = Abilities::TECHNICIAN;
+        ambipom.replace_move(PokemonMoveIndex::M0, Choices::ARMTHRUST);
+    }
+
+    let ins = run_turn(
+        &mut state,
+        &MoveChoice::Switch(PokemonIndex::P1),
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+        true,
+    );
+    let mut prob_triggered = 0.0f32;
+    let mut prob_not_triggered = 0.0f32;
+    for branch in &ins {
+        let mut s = state.clone();
+        s.apply_instructions(&branch.instruction_list);
+        if s.side_one.attack_boost == 1 {
+            assert_eq!(s.side_one.defense_boost, -1);
+            assert_eq!(s.side_one.special_attack_boost, 1);
+            assert_eq!(s.side_one.special_defense_boost, -1);
+            assert_eq!(s.side_one.speed_boost, 1);
+            prob_triggered += branch.percentage;
+        } else {
+            assert_eq!(s.side_one.attack_boost, 0);
+            assert_eq!(s.side_one.defense_boost, 0);
+            prob_not_triggered += branch.percentage;
+        }
+    }
+    assert!(
+        (prob_triggered + prob_not_triggered - 100.0).abs() < 0.1,
+        "probabilities should sum to 100"
+    );
+    assert!(
+        prob_triggered > 60.0 && prob_triggered < 70.0,
+        "expected ~66.5% Anger Shell trigger, got {}",
+        prob_triggered
+    );
+    assert!(
+        prob_not_triggered > 30.0 && prob_not_triggered < 40.0,
+        "expected ~33.5% no trigger, got {}",
+        prob_not_triggered
+    );
+}
