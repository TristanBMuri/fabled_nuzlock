+// Both sides switching (Showdown, Gen 5+): both mons come in, then their switch-in
+// abilities and items run in speed order, so the slower one's weather / Intimidate wins
+// or lands on the new foe.
+fn generate_instructions_from_double_switch(
+    state: &mut State,
+    side_one_index: PokemonIndex,
+    side_two_index: PokemonIndex,
+    incoming_instructions: &mut StateInstructions,
+) {
+    switch_in_without_effects(state, side_one_index, SideReference::SideOne, incoming_instructions);
+    switch_in_without_effects(state, side_two_index, SideReference::SideTwo, incoming_instructions);
+    let s1 = get_effective_speed(state, &SideReference::SideOne);
+    let s2 = get_effective_speed(state, &SideReference::SideTwo);
+    let side_one_first = if state.trick_room.active { s1 < s2 } else { s1 > s2 };
+    let order = if side_one_first {
+        [SideReference::SideOne, SideReference::SideTwo]
+    } else {
+        [SideReference::SideTwo, SideReference::SideOne]
+    };
+    for side_ref in order {
+        ability_on_switch_in(state, &side_ref, incoming_instructions);
+        item_on_switch_in(state, &side_ref, incoming_instructions);
+    }
+}
