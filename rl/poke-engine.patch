+// ---------------------------------------------------------------------------
+// Fighting-style class (PredictFightingStyle)
+// ---------------------------------------------------------------------------
+
+fn predict_class(mon: &Pokemon) -> FightingStyle {
+    let mut attacks = 0;
+    let mut status = 0;
+    let mut screens = 0;
+    let mut hazards = 0;
+    let mut boosting = false;
+    let mut phazing = false;
+    let mut leech = false;
+    let mut protect = false;
+
+    for mv in mon.moves.into_iter() {
+        if mv.id == Choices::NONE {
+            continue;
+        }
+        match mv.id {
+            Choices::BATONPASS => return FightingStyle::BatonPass,
+            Choices::HAZE | Choices::CLEARSMOG => return FightingStyle::Phazer,
+            Choices::WISH | Choices::HEALBELL | Choices::AROMATHERAPY => {
+                return FightingStyle::Cleric;
+            }
+            Choices::MEANLOOK
+            | Choices::BLOCK
+            | Choices::SPIDERWEB
+            | Choices::BIND
+            | Choices::WRAP
+            | Choices::FIRESPIN
+            | Choices::WHIRLPOOL
+            | Choices::SANDTOMB
+            | Choices::CLAMP
+            | Choices::INFESTATION
+            | Choices::MAGMASTORM
+            | Choices::SNAPTRAP
+            | Choices::THUNDERCAGE => return FightingStyle::Stall,
+            _ => {}
+        }
+        if matches!(
+            mon.item,
+            Items::CHOICEBAND | Items::CHOICESPECS | Items::CHOICESCARF | Items::ASSAULTVEST
+        ) {
+            return FightingStyle::Kill;
+        }
+        if matches!(
+            mv.id,
+            Choices::ROAR | Choices::WHIRLWIND | Choices::DRAGONTAIL | Choices::CIRCLETHROW
+        ) {
+            phazing = true;
+        }
+        if matches!(mv.id, Choices::REFLECT | Choices::LIGHTSCREEN) {
+            screens += 1;
+        } else if mv.id == Choices::AURORAVEIL {
+            screens += 2;
+        }
+        if mv.id == Choices::LEECHSEED {
+            leech = true;
+        }
+        if is_protect_move(mv.id) {
+            protect = true;
+        }
+        if mv.choice.category != MoveCategory::Status {
+            attacks += 1;
+        } else if is_hazard_move(mv.id) {
+            hazards += 1;
+        } else if self_boosts(&mv.choice).is_some() || mv.id == Choices::STOCKPILE {
+            boosting = true;
+        } else {
+            status += 1;
+        }
+    }
+
+    if screens >= 2 {
+        return if attacks >= 2 {
+            FightingStyle::ScreensSweeper
+        } else {
+            FightingStyle::Screens
+        };
+    }
+    if hazards > 0 {
+        return if phazing {
+            FightingStyle::Phazer
+        } else {
+            FightingStyle::Hazards
+        };
+    }
+    if attacks >= 3 {
+        return if boosting {
+            FightingStyle::SetupStats
+        } else if status > 0 || phazing {
+            FightingStyle::SetupStatus
+        } else {
+            FightingStyle::Kill
+        };
+    }
+    if leech && protect {
+        return FightingStyle::Stall;
+    }
+    if attacks >= 2 && (boosting || status > 0 || phazing) {
+        return if boosting {
+            FightingStyle::SetupStats
+        } else {
+            FightingStyle::SetupStatus
+        };
+    }
+    FightingStyle::Stall
+}
