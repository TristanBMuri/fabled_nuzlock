+pub fn rr_ignores_evasion(state: &State, attacking_side_ref: &SideReference) -> bool {
+    let (attacking_side, defending_side) = state.get_both_sides_immutable(attacking_side_ref);
+    if defending_side.get_active_immutable().ability == Abilities::NEUTRALIZINGGAS {
+        return false;
+    }
+    matches!(
+        attacking_side.get_active_immutable().ability,
+        Abilities::ILLUMINATE | Abilities::GOBEYOND
+    )
+}
