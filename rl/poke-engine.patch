+pub fn rr_ignores_accuracy(
+    state: &State,
+    choice: &Choice,
+    attacking_side_ref: &SideReference,
+) -> bool {
+    let (attacking_side, defending_side) = state.get_both_sides_immutable(attacking_side_ref);
+    let attacker = attacking_side.get_active_immutable();
+    let defender = defending_side.get_active_immutable();
+    if attacker.ability == Abilities::NEUTRALIZINGGAS
+        || defender.ability == Abilities::NEUTRALIZINGGAS
+    {
+        return false;
+    }
+    defender.ability == Abilities::GOBEYOND
+        && !ignores_target_ability(attacker, choice, &defender.ability)
+}
