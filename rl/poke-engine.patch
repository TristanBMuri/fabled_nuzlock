+#[test]
+fn test_rr_sonicslash_speed_ratio_and_tankwatch_uses_def() {
+    // Sonic Slash: 3x speed -> 140 BP vs 1x speed -> 80 BP
+    let mut slow = State::default();
+    slow.side_one.get_active().speed = 100;
+    slow.side_two.get_active().speed = 100;
+    slow.side_two.get_active().hp = 500;
+    let slow_out = run_turn(&mut slow, Choices::SONICSLASH, Choices::SPLASH);
+    let slow_dmg = slow_out[0]
+        .instruction_list
+        .iter()
+        .find_map(|i| match i {
+            Instruction::Damage(d) => Some(d.damage_amount),
+            _ => None,
+        })
+        .unwrap();
+
+    let mut fast = slow.clone();
+    fast.side_one.get_active().speed = 300;
+    let fast_out = run_turn(&mut fast, Choices::SONICSLASH, Choices::SPLASH);
+    let fast_dmg = fast_out[0]
+        .instruction_list
+        .iter()
+        .find_map(|i| match i {
+            Instruction::Damage(d) => Some(d.damage_amount),
+            _ => None,
+        })
+        .unwrap();
+    assert!((fast_dmg as f32 / slow_dmg as f32 - 140.0 / 80.0).abs() < 0.1);
+
+    // Tankwatch uses Defense as attacking stat
+    let mut tw = State::default();
+    tw.side_one.get_active().attack = 50;
+    tw.side_one.get_active().defense = 200;
+    let mv = MOVES.get(&Choices::TANKWATCH).unwrap();
+    let (dmg, _) = calculate_damage(&tw, &SideReference::SideOne, mv, DamageRolls::Max).unwrap();
+    // 80 BP, 200 Def vs 100 Def -> ~136
+    assert!(dmg >= 130 && dmg <= 145, "got {}", dmg);
+}
