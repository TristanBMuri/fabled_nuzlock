+#![cfg(feature = "rr")]
+//! The gaps that sent RR positions from poke-engine back to Showdown (nuzlock_rl rl/route.py GAPS).
+
+use poke_engine::choices::Choices;
+use poke_engine::engine::generate_instructions::generate_instructions_from_move_pair;
+use poke_engine::engine::state::{MoveChoice, PokemonVolatileStatus};
+use poke_engine::instruction::{
+    ApplyVolatileStatusInstruction, Instruction, RemoveVolatileStatusInstruction,
+    StateInstructions,
+};
+use poke_engine::state::{PokemonMoveIndex, SideReference, State};
+
+fn run_turn(state: &mut State, s1: &MoveChoice, s2: &MoveChoice) -> Vec<StateInstructions> {
+    state.set_conditional_mechanics();
+    let before = format!("{:?}", state);
+    let ins = generate_instructions_from_move_pair(state, s1, s2, false);
+    assert_eq!(before, format!("{:?}", state), "state was not cleanly reversed");
+    ins
+}
+
+/// side one uses Rollout (M0) into a bulky side two using `foe_move`
+fn rollout_state(foe_move: Choices) -> State {
+    let mut state = State::default();
+    state
+        .side_one
+        .get_active()
+        .replace_move(PokemonMoveIndex::M0, Choices::ROLLOUT);
+    let foe = state.side_two.get_active();
+    foe.replace_move(PokemonMoveIndex::M0, foe_move);
+    foe.hp = 2000;
+    foe.maxhp = 2000;
+    state
+}
+
+fn damage_to_foe(ins: &StateInstructions) -> i16 {
+    ins.instruction_list
+        .iter()
+        .filter_map(|i| match i {
+            Instruction::Damage(d) if d.side_ref == SideReference::SideTwo => Some(d.damage_amount),
+            _ => None,
+        })
+        .sum()
+}
+
+fn applies(ins: &StateInstructions, v: PokemonVolatileStatus) -> bool {
+    ins.instruction_list
+        .contains(&Instruction::ApplyVolatileStatus(ApplyVolatileStatusInstruction {
+            side_ref: SideReference::SideOne,
+            volatile_status: v,
+        }))
+}
+
+fn removes(ins: &StateInstructions, v: PokemonVolatileStatus) -> bool {
+    ins.instruction_list
+        .contains(&Instruction::RemoveVolatileStatus(RemoveVolatileStatusInstruction {
+            side_ref: SideReference::SideOne,
+            volatile_status: v,
+        }))
+}
+
+fn turn(state: &mut State) -> Vec<StateInstructions> {
+    run_turn(
+        state,
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+    )
+}
+
+#[test]
+fn test_rollout_first_hit_locks_in_and_a_miss_does_not() {
+    let mut state = rollout_state(Choices::SPLASH);
+    let ins = turn(&mut state);
+    assert_eq!(ins.len(), 2); // 10% miss, 90% hit
+    let (miss, hit) = (&ins[0], &ins[1]);
+    assert!((miss.percentage - 10.0).abs() < 1e-3 && damage_to_foe(miss) == 0);
+    assert!(!applies(miss, PokemonVolatileStatus::ROLLOUT1));
+    assert!(applies(hit, PokemonVolatileStatus::ROLLOUT1));
+}
+
+#[test]
+fn test_rollout_power_doubles_per_hit_and_with_defense_curl() {
+    let first = damage_to_foe(&turn(&mut rollout_state(Choices::SPLASH))[1]);
+    let mut state = rollout_state(Choices::SPLASH);
+    state
+        .side_one
+        .volatile_statuses
+        .insert(PokemonVolatileStatus::ROLLOUT2);
+    let ins = turn(&mut state);
+    let third = &ins[1];
+    assert!(removes(third, PokemonVolatileStatus::ROLLOUT2));
+    assert!(applies(third, PokemonVolatileStatus::ROLLOUT3));
+    let third_damage = damage_to_foe(third);
+    let ratio = third_damage as f32 / first as f32;
+    assert!((ratio - 4.0).abs() < 0.3, "120 BP vs 30 BP: {}", ratio);
+    // the miss ends the lock-in
+    assert!(removes(&ins[0], PokemonVolatileStatus::ROLLOUT2));
+    assert!(!applies(&ins[0], PokemonVolatileStatus::ROLLOUT3));
+
+    state
+        .side_one
+        .volatile_statuses
+        .insert(PokemonVolatileStatus::DEFENSECURL);
+    let curled = damage_to_foe(&turn(&mut state)[1]) as f32 / third_damage as f32;
+    assert!((curled - 2.0).abs() < 0.1, "Defense Curl doubles: {}", curled);
+}
