+//! Radical Red / CFRU trainer AI port (singles) for poke-engine (`rr` feature).
+//!
+//! Mirrors `ai_util/rr_ai.py`: fighting-style class, negative/positive move scoring tiers,
+//! voluntary switching triggers (`ai_switching.c`), and post-KO switch-in scoring.
+//! Uses poke-engine's own damage calculation (`calculate_damage` at the mean 0.925 roll
+//! with choice/ability/item modifiers) and effective speed. Returns all choices tied for
+//! the top score (usually one).
+
+use super::abilities::{
+    ability_modify_attack_against, ability_modify_attack_being_used, ignores_target_ability,
+    Abilities,
+};
+use super::choice_effects::modify_choice;
+use super::damage_calc::{calculate_damage, type_effectiveness_modifier, DamageRolls};
+use super::generate_instructions::get_effective_speed;
+use super::items::{item_modify_attack_against, item_modify_attack_being_used, Items};
+use super::state::{MoveChoice, PokemonVolatileStatus, Terrain, Weather};
+use crate::choices::{
+    Choice, Choices, Effect, MoveCategory, MoveTarget, MultiHitMove, StatBoosts,
+};
+use crate::state::{
+    LastUsedMove, Pokemon, PokemonBoostableStat, PokemonIndex, PokemonMoveIndex, PokemonStatus,
+    PokemonType, Side, SideConditions, SideReference, State, VolatileStatusBitset,
+};
+
+const BASE_SCORE: i32 = 100;
+const KO_BONUS: i32 = 9;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum FightingStyle {
+    BatonPass,
+    Phazer,
+    Cleric,
+    Stall,
+    Kill,
+    ScreensSweeper,
+    Screens,
+    Hazards,
+    SetupStats,
+    SetupStatus,
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+struct SwitchFlags {
+    outspeeds: bool,
+    ko: bool,
+    revenge: bool,
+    two_hko: bool,
+    faints: bool,
+    resists: bool,
+    walls: bool,
+}
+
+impl SwitchFlags {
+    fn outspeeds_walls_or_resists(self) -> bool {
+        self.outspeeds || self.walls || self.resists
+    }
+    fn walls_or_resists(self) -> bool {
+        self.walls || self.resists
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+struct RankedSwitch {
+    index: PokemonIndex,
+    score: i32,
+    flags: SwitchFlags,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum PivotDecision {
+    Pivot,
+    Try,
+    Dont,
+}
+
+/// Snapshot of the per-active-mon fields of a `Side`, allowing zero-allocation
+/// bench-mon damage/speed evaluation on `&mut State`.
+struct ActiveSnapshot {
+    active_index: PokemonIndex,
+    attack_boost: i8,
+    defense_boost: i8,
+    special_attack_boost: i8,
+    special_defense_boost: i8,
+    speed_boost: i8,
+    accuracy_boost: i8,
+    evasion_boost: i8,
+    volatile_statuses: VolatileStatusBitset,
+    substitute_health: i16,
+    last_used_move: LastUsedMove,
+    toxic_count: i8,
+}
+
+fn with_bench_active<R>(
+    state: &mut State,
+    side_ref: SideReference,
+    bench_idx: PokemonIndex,
+    f: impl FnOnce(&State) -> R,
+) -> R {
+    let side = state.get_side(&side_ref);
+    let snap = ActiveSnapshot {
+        active_index: side.active_index,
+        attack_boost: side.attack_boost,
+        defense_boost: side.defense_boost,
+        special_attack_boost: side.special_attack_boost,
+        special_defense_boost: side.special_defense_boost,
+        speed_boost: side.speed_boost,
+        accuracy_boost: side.accuracy_boost,
+        evasion_boost: side.evasion_boost,
+        volatile_statuses: side.volatile_statuses.clone(),
+        substitute_health: side.substitute_health,
+        last_used_move: side.last_used_move,
+        toxic_count: side.side_conditions.toxic_count,
+    };
+    side.active_index = bench_idx;
+    side.attack_boost = 0;
+    side.defense_boost = 0;
+    side.special_attack_boost = 0;
+    side.special_defense_boost = 0;
+    side.speed_boost = 0;
+    side.accuracy_boost = 0;
+    side.evasion_boost = 0;
+    side.volatile_statuses = VolatileStatusBitset::default();
+    side.substitute_health = 0;
+    side.last_used_move = LastUsedMove::Switch(bench_idx);
+    side.side_conditions.toxic_count = 0;
+
+    let res = f(state);
+
+    let side = state.get_side(&side_ref);
+    side.active_index = snap.active_index;
+    side.attack_boost = snap.attack_boost;
+    side.defense_boost = snap.defense_boost;
+    side.special_attack_boost = snap.special_attack_boost;
+    side.special_defense_boost = snap.special_defense_boost;
+    side.speed_boost = snap.speed_boost;
+    side.accuracy_boost = snap.accuracy_boost;
+    side.evasion_boost = snap.evasion_boost;
+    side.volatile_statuses = snap.volatile_statuses;
+    side.substitute_health = snap.substitute_health;
+    side.last_used_move = snap.last_used_move;
+    side.side_conditions.toxic_count = snap.toxic_count;
+    res
+}
+
+/// Public entry point: returns all tied top choices for `side` according to the RR AI.
+pub fn rr_ai_choice(state: &State, side: SideReference) -> Vec<MoveChoice> {
+    let (s1_opts, s2_opts) = state.root_get_all_options();
+    let options = match side {
+        SideReference::SideOne => s1_opts,
+        SideReference::SideTwo => s2_opts,
+    };
+    if options.len() <= 1 {
+        return options;
+    }
+    let has_switches = options.iter().any(|o| matches!(o, MoveChoice::Switch(_)));
+    if !has_switches {
+        // No bench evaluation needed: run without cloning `state`.
+        return rr_ai_choose_from_options_immut(state, side, &options);
+    }
+    let mut cloned = state.clone();
+    rr_ai_choose_from_options(&mut cloned, side, &options)
+}
+
+/// Zero-clone entry point for MCTS (which already owns `&mut State`).
+pub fn rr_ai_choice_mut(state: &mut State, side: SideReference) -> Vec<MoveChoice> {
+    let (s1_opts, s2_opts) = state.root_get_all_options();
+    let options = match side {
+        SideReference::SideOne => s1_opts,
+        SideReference::SideTwo => s2_opts,
+    };
+    if options.len() <= 1 {
+        return options;
+    }
+    rr_ai_choose_from_options(state, side, &options)
+}
+
+fn rr_ai_choose_from_options_immut(
+    state: &State,
+    side: SideReference,
+    options: &[MoveChoice],
+) -> Vec<MoveChoice> {
+    let mut avail_moves: Vec<(MoveChoice, PokemonMoveIndex)> = Vec::with_capacity(4);
+    for &opt in options {
+        if let Some(mi) = move_choice_index(opt) {
+            avail_moves.push((opt, mi));
+        }
+    }
+    if avail_moves.is_empty() {
+        return options.to_vec();
+    }
+    score_and_pick_moves(state, side, &avail_moves, &[]).0
+}
+
+fn rr_ai_choose_from_options(
+    state: &mut State,
+    side: SideReference,
+    options: &[MoveChoice],
+) -> Vec<MoveChoice> {
+    let mut avail_moves: Vec<(MoveChoice, PokemonMoveIndex)> = Vec::with_capacity(4);
+    let mut avail_switches: Vec<PokemonIndex> = Vec::with_capacity(5);
+    for &opt in options {
+        if let Some(mi) = move_choice_index(opt) {
+            avail_moves.push((opt, mi));
+        } else if let MoveChoice::Switch(pi) = opt {
+            avail_switches.push(pi);
+        }
+    }
+
+    // Forced switch (active fainted, U-turn/Flip Turn pivot, or team preview)
+    if avail_moves.is_empty() {
+        if avail_switches.is_empty() {
+            return options.to_vec();
+        }
+        let foe_alive = state
+            .get_side_immutable(&side.get_other_side())
+            .get_active_immutable()
+            .hp
+            > 0;
+        if !foe_alive {
+            return avail_switches.into_iter().map(MoveChoice::Switch).collect();
+        }
+        let ranked = ranked_switches(state, side, &avail_switches);
+        return top_tied_switches(&ranked);
+    }
+
+    let ranked = if avail_switches.is_empty() {
+        Vec::new()
+    } else {
+        ranked_switches(state, side, &avail_switches)
+    };
+
+    let (tied_moves, best_score) = score_and_pick_moves(state, side, &avail_moves, &ranked);
+
+    if !ranked.is_empty() {
+        if let Some(switch_targets) = switch_target(state, side, best_score, &ranked) {
+            return switch_targets;
+        }
+    }
+
+    if !tied_moves.is_empty() {
+        return tied_moves;
+    }
+
+    if !ranked.is_empty() {
+        return top_tied_switches(&ranked);
+    }
+
+    options.to_vec()
+}
+
+fn move_choice_index(opt: MoveChoice) -> Option<PokemonMoveIndex> {
+    match opt {
+        MoveChoice::Move(i) | MoveChoice::MoveMega(i) | MoveChoice::MoveTera(i) => Some(i),
+        _ => None,
+    }
+}
+
+fn top_tied_switches(ranked: &[RankedSwitch]) -> Vec<MoveChoice> {
+    let first = ranked[0];
+    ranked
+        .iter()
+        .filter(|r| r.score == first.score && r.flags.faints == first.flags.faints)
+        .map(|r| MoveChoice::Switch(r.index))
+        .collect()
+}
+
+fn score_and_pick_moves(
+    state: &State,
+    side: SideReference,
+    avail_moves: &[(MoveChoice, PokemonMoveIndex)],
+    ranked: &[RankedSwitch],
+) -> (Vec<MoveChoice>, i32) {
+    let (my_side, foe_side) = state.get_both_sides_immutable(&side);
+    let active = my_side.get_active_immutable();
+    let foe = foe_side.get_active_immutable();
+    let cls = predict_class(active);
+    let foe_move = predict_foe_move(state, side);
+    let foe_best = foe_best_hit(state, side);
+
+    let mut best_score = i32::MIN;
+    let mut tied: Vec<MoveChoice> = Vec::with_capacity(4);
+    for &(opt, mi) in avail_moves {
+        let choice = &active.moves[&mi].choice;
+        let score = BASE_SCORE
+            + negatives(state, side, choice, foe_move)
+            + positives(
+                state,
+                side,
+                choice,
+                cls,
+                foe_move,
+                foe_best,
+                avail_moves,
+                ranked,
+            );
+        if score > best_score {
+            best_score = score;
+            tied.clear();
+            tied.push(opt);
+        } else if score == best_score {
+            tied.push(opt);
+        }
+    }
+    let _ = foe;
+    (tied, best_score)
+}
+
+// ---------------------------------------------------------------------------
+// Damage, speed, immunity & move classification helpers
+// ---------------------------------------------------------------------------
+
+fn hp_frac(mon: &Pokemon) -> f32 {
+    if mon.maxhp <= 0 {
+        0.0
+    } else {
+        (mon.hp.max(0) as f32) / (mon.maxhp as f32)
+    }
+}
+
+fn is_first_turn(side: &Side) -> bool {
+    matches!(side.last_used_move, LastUsedMove::Switch(_))
+}
+
+fn is_protect_move(id: Choices) -> bool {
+    matches!(
+        id,
+        Choices::PROTECT
+            | Choices::DETECT
+            | Choices::SPIKYSHIELD
+            | Choices::KINGSSHIELD
+            | Choices::BANEFULBUNKER
+            | Choices::OBSTRUCT
+            | Choices::SILKTRAP
+            | Choices::BURNINGBULWARK
+            | Choices::ENDURE
+    )
+}
+
+fn is_recovery_move(choice: &Choice) -> bool {
+    choice.heal.is_some()
+        || matches!(
+            choice.move_id,
+            Choices::RECOVER
+                | Choices::SOFTBOILED
+                | Choices::ROOST
+                | Choices::SLACKOFF
+                | Choices::MOONLIGHT
+                | Choices::MORNINGSUN
+                | Choices::SYNTHESIS
+                | Choices::SHOREUP
+                | Choices::MILKDRINK
+                | Choices::HEALORDER
+                | Choices::REST
+                | Choices::WISH
+                | Choices::STRENGTHSAP
+        )
+}
+
+fn heal_amount(choice: &Choice) -> f32 {
+    if choice.move_id == Choices::REST {
+        1.0
+    } else if let Some(h) = &choice.heal {
+        if h.amount > 0.0 {
+            h.amount
+        } else {
+            0.5
+        }
+    } else {
+        0.5
+    }
+}
+
+fn is_hazard_move(id: Choices) -> bool {
+    matches!(
+        id,
+        Choices::STEALTHROCK | Choices::SPIKES | Choices::TOXICSPIKES | Choices::STICKYWEB
+    )
+}
+
+fn is_hazard_removal(id: Choices) -> bool {
+    matches!(
+        id,
+        Choices::RAPIDSPIN
+            | Choices::DEFOG
+            | Choices::COURTCHANGE
+            | Choices::TIDYUP
+            | Choices::MORTALSPIN
+    )
+}
+
+fn is_screen_move(id: Choices) -> bool {
+    matches!(
+        id,
+        Choices::REFLECT | Choices::LIGHTSCREEN | Choices::AURORAVEIL
+    )
+}
+
+fn is_first_turn_only(id: Choices) -> bool {
+    matches!(id, Choices::FAKEOUT | Choices::FIRSTIMPRESSION)
+}
+
+fn is_self_destruct(id: Choices) -> bool {
+    matches!(
+        id,
+        Choices::SELFDESTRUCT
+            | Choices::EXPLOSION
+            | Choices::MISTYEXPLOSION
+            | Choices::FINALGAMBIT
+            | Choices::HEALINGWISH
+            | Choices::LUNARDANCE
+            | Choices::MEMENTO
+    )
+}
+
+fn is_pivot_move(choice: &Choice) -> bool {
+    (choice.flags.pivot || choice.move_id == Choices::SHEDTAIL)
+        && choice.move_id != Choices::BATONPASS
+}
+
+fn has_any_side_condition(sc: &SideConditions) -> bool {
+    sc.stealth_rock > 0
+        || sc.spikes > 0
+        || sc.toxic_spikes > 0
+        || sc.sticky_web > 0
+        || sc.reflect > 0
+        || sc.light_screen > 0
+        || sc.aurora_veil > 0
+        || sc.mist > 0
+        || sc.safeguard > 0
+        || sc.tailwind > 0
+}
+
+fn self_boosts(choice: &Choice) -> Option<StatBoosts> {
+    if let Some(b) = &choice.boost {
+        if b.target == MoveTarget::User {
+            return Some(b.boosts.clone());
+        }
+    }
+    None
+}
+
+fn is_absorb_ability(ab: Abilities) -> bool {
+    matches!(
+        ab,
+        Abilities::FLASHFIRE
+            | Abilities::VOLTABSORB
+            | Abilities::LIGHTNINGROD
+            | Abilities::MOTORDRIVE
+            | Abilities::WATERABSORB
+            | Abilities::DRYSKIN
+            | Abilities::STORMDRAIN
+            | Abilities::SAPSIPPER
+    )
+}
+
+fn ability_absorbs_type(ab: Abilities, t: PokemonType) -> bool {
+    match t {
+        PokemonType::FIRE => matches!(ab, Abilities::FLASHFIRE),
+        PokemonType::ELECTRIC => matches!(
+            ab,
+            Abilities::VOLTABSORB | Abilities::LIGHTNINGROD | Abilities::MOTORDRIVE
+        ),
+        PokemonType::WATER => matches!(
+            ab,
+            Abilities::WATERABSORB | Abilities::DRYSKIN | Abilities::STORMDRAIN
+        ),
+        PokemonType::GRASS => matches!(ab, Abilities::SAPSIPPER),
+        _ => false,
+    }
+}
+
+fn resist_berry_type(item: Items) -> Option<PokemonType> {
+    match item {
+        Items::CHILANBERRY => Some(PokemonType::NORMAL),
+        Items::OCCABERRY => Some(PokemonType::FIRE),
+        Items::PASSHOBERRY => Some(PokemonType::WATER),
+        Items::WACANBERRY => Some(PokemonType::ELECTRIC),
+        Items::RINDOBERRY => Some(PokemonType::GRASS),
+        Items::YACHEBERRY => Some(PokemonType::ICE),
+        Items::CHOPLEBERRY => Some(PokemonType::FIGHTING),
+        Items::KEBIABERRY => Some(PokemonType::POISON),
+        Items::SHUCABERRY => Some(PokemonType::GROUND),
+        Items::COBABERRY => Some(PokemonType::FLYING),
+        Items::PAYAPABERRY => Some(PokemonType::PSYCHIC),
+        Items::TANGABERRY => Some(PokemonType::BUG),
+        Items::CHARTIBERRY => Some(PokemonType::ROCK),
+        Items::KASIBBERRY => Some(PokemonType::GHOST),
+        Items::HABANBERRY => Some(PokemonType::DRAGON),
+        Items::COLBURBERRY => Some(PokemonType::DARK),
+        Items::BABIRIBERRY => Some(PokemonType::STEEL),
+        Items::ROSELIBERRY => Some(PokemonType::FAIRY),
+        _ => None,
+    }
+}
+
+fn is_immune_damaging(attacker: &Pokemon, defender: &Pokemon, choice: &Choice) -> bool {
+    if choice.category == MoveCategory::Status {
+        return false;
+    }
+    let mtype = choice.move_type;
+    if mtype == PokemonType::GROUND && defender.item == Items::AIRBALLOON {
+        return true;
+    }
+    let mult = type_effectiveness_modifier(&mtype, defender);
+    if mult == 0.0 {
+        let scrappy = matches!(attacker.ability, Abilities::SCRAPPY | Abilities::MINDSEYE)
+            && matches!(mtype, PokemonType::NORMAL | PokemonType::FIGHTING)
+            && defender.has_type(&PokemonType::GHOST);
+        if !scrappy {
+            return true;
+        }
+    }
+    if !ignores_target_ability(attacker, choice, &defender.ability) {
+        match defender.ability {
+            Abilities::LEVITATE | Abilities::EELEVATE | Abilities::EARTHEATER
+                if mtype == PokemonType::GROUND =>
+            {
+                return true;
+            }
+            Abilities::WATERABSORB | Abilities::DRYSKIN | Abilities::STORMDRAIN
+                if mtype == PokemonType::WATER =>
+            {
+                return true;
+            }
+            Abilities::VOLTABSORB | Abilities::LIGHTNINGROD | Abilities::MOTORDRIVE
+                if mtype == PokemonType::ELECTRIC =>
+            {
+                return true;
+            }
+            Abilities::FLASHFIRE | Abilities::WELLBAKEDBODY if mtype == PokemonType::FIRE => {
+                return true;
+            }
+            Abilities::SAPSIPPER if mtype == PokemonType::GRASS => return true,
+            Abilities::SOUNDPROOF if choice.flags.sound => return true,
+            Abilities::BULLETPROOF if choice.flags.bullet => return true,
+            Abilities::WONDERGUARD if mult < 2.0 => return true,
+            _ => {}
+        }
+    }
+    false
+}
+
+/// Expected fraction of defender's max HP removed by one use of `raw_choice` (without accuracy),
+/// using poke-engine's damage calculation and choice/ability/item modifiers.
+fn hit_frac(state: &State, att_side_ref: SideReference, raw_choice: &Choice) -> f32 {
+    if raw_choice.category == MoveCategory::Status || raw_choice.category == MoveCategory::Switch {
+        return 0.0;
+    }
+    let (att_side, def_side) = state.get_both_sides_immutable(&att_side_ref);
+    let attacker = att_side.get_active_immutable();
+    let defender = def_side.get_active_immutable();
+    if defender.maxhp <= 0 {
+        return 0.0;
+    }
+
+    let fixed_opt = raw_choice
+        .move_id
+        .fixed_damage(attacker, defender)
+        .or(match raw_choice.move_id {
+            Choices::DRAGONRAGE => Some(40),
+            Choices::SONICBOOM => Some(20),
+            _ => None,
+        });
+    if let Some(fixed) = fixed_opt {
+        let ignores_type = matches!(
+            raw_choice.move_id,
+            Choices::NATURESMADNESS | Choices::RUINATION
+        );
+        if !ignores_type && is_immune_damaging(attacker, defender, raw_choice) {
+            return 0.0;
+        }
+        return (fixed.min(defender.maxhp) as f32) / (defender.maxhp as f32);
+    }
+
+    let mut choice = raw_choice.clone();
+    choice.first_move = true;
+    let dummy_def = Choice {
+        category: MoveCategory::Physical,
+        base_power: 40.0,
+        ..Default::default()
+    };
+
+    modify_choice(state, &mut choice, &dummy_def, &att_side_ref);
+    ability_modify_attack_being_used(state, &mut choice, &dummy_def, &att_side_ref);
+    ability_modify_attack_against(state, &mut choice, &dummy_def, &att_side_ref);
+    item_modify_attack_being_used(state, &mut choice, &att_side_ref);
+    item_modify_attack_against(state, &mut choice, &att_side_ref);
+
+    if choice.category == MoveCategory::Status || choice.base_power <= 0.0 {
+        return 0.0;
+    }
+
+    let Some((dmg, _)) = calculate_damage(state, &att_side_ref, &choice, DamageRolls::Average)
+    else {
+        return 0.0;
+    };
+    let mut total = dmg as f32;
+    if total <= 0.0 {
+        return 0.0;
+    }
+
+    // Resist berries are consumed in item_before_move rather than item_modify_attack_against.
+    if let Some(berry_type) = resist_berry_type(defender.item) {
+        if berry_type == choice.move_type {
+            let eff = type_effectiveness_modifier(&choice.move_type, defender);
+            if eff > 1.0 || choice.move_type == PokemonType::NORMAL {
+                total = (total * 0.5).floor();
+            }
+        }
+    }
+
+    // Multi-hit expected hits (poke-engine calculates a single hit).
+    let hits = match choice.multi_hit() {
+        MultiHitMove::None => 1.0,
+        MultiHitMove::DoubleHit => 2.0,
+        MultiHitMove::TripleHit | MultiHitMove::TripleAxel => 3.0,
+        MultiHitMove::QuadHit => 4.0,
+        MultiHitMove::TwoToFiveHits => {
+            if attacker.ability == Abilities::SKILLLINK {
+                5.0
+            } else if attacker.item == Items::LOADEDDICE {
+                4.5
+            } else {
+                3.166_666_7
+            }
+        }
+        MultiHitMove::PopulationBomb => 10.0,
+    };
+    total *= hits;
+
+    // Two-turn charge moves deal half damage per turn unless sun/rain/Power Herb skips charge.
+    let weather = state.get_weather();
+    let skip_charge = attacker.item == Items::POWERHERB
+        || (matches!(choice.move_id, Choices::SOLARBEAM | Choices::SOLARBLADE)
+            && matches!(weather, Weather::SUN | Weather::HARSHSUN))
+        || (choice.move_id == Choices::ELECTROSHOT
+            && matches!(weather, Weather::RAIN | Weather::HEAVYRAIN));
+    if choice.flags.charge && !skip_charge {
+        total *= 0.5;
+    }
+
+    total / (defender.maxhp as f32)
+}
+
+fn attacks_of<'a>(mon: &'a Pokemon) -> impl Iterator<Item = &'a Choice> {
+    mon.moves
+        .into_iter()
+        .filter(|m| m.id != Choices::NONE && m.choice.category != MoveCategory::Status)
+        .map(|m| &m.choice)
+}
+
+fn mon_has_move(mon: &Pokemon, id: Choices) -> bool {
+    mon.moves.into_iter().any(|m| m.id == id)
+}
+
+fn can_ko(state: &State, att_side: SideReference, hits: f32) -> bool {
+    let (att, def) = state.get_both_sides_immutable(&att_side);
+    let dfn_hp = hp_frac(def.get_active_immutable());
+    attacks_of(att.get_active_immutable()).any(|c| hits * hit_frac(state, att_side, c) >= dfn_hp)
+}
+
+fn foe_best_hit(state: &State, my_side: SideReference) -> f32 {
+    let foe_side = my_side.get_other_side();
+    let foe = state.get_side_immutable(&foe_side).get_active_immutable();
+    attacks_of(foe)
+        .map(|c| hit_frac(state, foe_side, c))
+        .fold(0.0f32, f32::max)
+}
+
+fn predict_foe_move<'a>(state: &'a State, my_side: SideReference) -> Option<&'a Choice> {
+    let foe_side = my_side.get_other_side();
+    let foe = state.get_side_immutable(&foe_side).get_active_immutable();
+    let mut best: Option<(&'a Choice, f32)> = None;
+    for c in attacks_of(foe) {
+        let d = hit_frac(state, foe_side, c);
+        if best.map_or(true, |(_, bd)| d > bd) {
+            best = Some((c, d));
+        }
+    }
+    best.map(|(c, _)| c)
+}
+
+fn goes_first(
+    state: &State,
+    my_side: SideReference,
+    my_choice: &Choice,
+    foe_choice: Option<&Choice>,
+) -> bool {
+    let p = my_choice.priority;
+    let q = foe_choice.map_or(0, |c| c.priority);
+    if p != q {
+        return p > q;
+    }
+    get_effective_speed(state, &my_side) > get_effective_speed(state, &my_side.get_other_side())
+}
+
+fn n_remaining(side: &Side) -> usize {
+    side.pokemon.into_iter().filter(|p| p.hp > 0).count()
+}
