@@ -0,0 +1,23 @@
+# The Radical Red build of the Python bindings: same source as poke-engine-py, engine built
+# with the `rr` feature (gen9 + the gen9rr mod's data and mechanics). Installed as the
+# Python package `poke_engine_rr` next to the Gen 8 `poke_engine`; its own workspace, so
+# the two cdylibs (both named poke_engine) never share a target dir.
+[package]
+name = "poke_engine_rr"
+edition = "2021"
+version = "0.0.48"
+
+[lib]
+name = "poke_engine"
+path = "../poke-engine-py/src/lib.rs"
+crate-type = ["cdylib"]
+
+[dependencies]
+pyo3 = { version = "0.29.0", features = ["extension-module"] }
+poke-engine = { path = "../", default-features = false, features = ["rr"] }
+
+[features]
+default = ["rr"]
+rr = []
+
+[workspace]
