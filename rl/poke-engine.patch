+pub fn rr_modify_speed(state: &State, side_reference: &SideReference, mut speed: f32) -> f32 {
+    let (side, other_side) = state.get_both_sides_immutable(side_reference);
+    if other_side.get_active_immutable().ability == Abilities::NEUTRALIZINGGAS {
+        return speed;
+    }
+    let active_pkmn = side.get_active_immutable();
+    match active_pkmn.ability {
+        Abilities::BULLRUSH | Abilities::QUILLRUSH => {
+            if !matches!(side.last_used_move, LastUsedMove::Move(_)) {
+                speed *= 1.5;
+            }
+        }
+        Abilities::GEARSTURNING => {
+            if active_pkmn.hp == active_pkmn.maxhp {
+                speed *= 1.5;
+            }
+        }
+        Abilities::QUICKFEET => {
+            if active_pkmn.status != PokemonStatus::NONE {
+                speed *= 2.0;
+            }
+        }
+        Abilities::FLOWERGIFT => {
+            if matches!(
+                active_pkmn.id,
+                PokemonName::CHERRIM | PokemonName::CHERRIMSUNSHINE
+            ) && (state.weather_is_active(&Weather::SUN)
+                || state.weather_is_active(&Weather::HARSHSUN))
+            {
+                speed *= 1.5;
+            }
+        }
+        _ => {}
+    }
+    speed
+}
