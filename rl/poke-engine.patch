+fn test_fatalprecision_se_never_misses_and_boosts_damage() {
+    // Super-effective Fire Blast vs Grass: 206 dmg and 100% accuracy (even with +6 evasion).
+    let mut state = State::default();
+    state.side_one.get_active().ability = Abilities::FATALPRECISION;
+    state.side_two.get_active().types = (PokemonType::GRASS, PokemonType::TYPELESS);
+    state.side_two.get_active().hp = 300;
+    state.side_two.get_active().maxhp = 300;
+    state.side_two.evasion_boost = 6;
+    let ins = run_moves(&mut state, Choices::FIREBLAST, Choices::SPLASH);
+    // Single 100% hit branch (plus 10% burn branch -> total 100%, no miss branch!).
+    let total_dmg_pct: f32 = ins
+        .iter()
+        .filter(|si| {
+            si.instruction_list.contains(&Instruction::Damage(
+                DamageInstruction {
+                    side_ref: SideReference::SideTwo,
+                    damage_amount: 206,
+                },
+            ))
+        })
+        .map(|si| si.percentage)
+        .sum();
+    assert!((total_dmg_pct - 100.0).abs() < 1e-3, "ins={:?}", ins);
+
+    // Neutral Fire Blast vs Normal: normal 87 dmg and can miss (85% hit).
+    let mut state = State::default();
+    state.side_one.get_active().ability = Abilities::FATALPRECISION;
+    state.side_two.get_active().types = (PokemonType::NORMAL, PokemonType::TYPELESS);
+    state.side_two.get_active().hp = 300;
+    state.side_two.get_active().maxhp = 300;
+    let ins = run_moves(&mut state, Choices::FIREBLAST, Choices::SPLASH);
+    let miss_pct: f32 = ins
+        .iter()
+        .filter(|si| si.instruction_list.is_empty())
+        .map(|si| si.percentage)
+        .sum();
+    assert!((miss_pct - 15.0).abs() < 1e-3, "ins={:?}", ins);
+    assert!(ins.iter().any(|si| {
+        si.instruction_list.contains(&Instruction::Damage(
+            DamageInstruction {
+                side_ref: SideReference::SideTwo,
+                damage_amount: 87,
+            },
+        ))
+    }));
+}
