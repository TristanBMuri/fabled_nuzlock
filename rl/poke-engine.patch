+/// RR `modify_choice` hooks.
+pub fn rr_modify_choice(
+    state: &State,
+    attacker_choice: &mut Choice,
+    _defender_choice: &Choice,
+    attacking_side_ref: &SideReference,
+) {
+    let (attacking_side, defending_side) = state.get_both_sides_immutable(attacking_side_ref);
+    let attacker = attacking_side.get_active_immutable();
+    let defender = defending_side.get_active_immutable();
+
+    match attacker_choice.move_id {
+        Choices::DRACOBARRAGE => {
+            if attacking_side.calculate_boosted_stat(PokemonBoostableStat::Attack)
+                > attacking_side.calculate_boosted_stat(PokemonBoostableStat::SpecialAttack)
+            {
+                attacker_choice.category = MoveCategory::Physical;
+            }
+        }
+        Choices::AURAWHEEL => {
+            if !matches!(
+                attacker.id,
+                PokemonName::MORPEKO | PokemonName::MORPEKOHANGRY | PokemonName::PIKACHULIBRE
+            ) {
+                attacker_choice.remove_all_effects();
+            }
+        }
+        Choices::BARBBARRAGE | Choices::BITTERMALICE | Choices::INFERNALPARADE => {
+            if defender.status != PokemonStatus::NONE || defender.ability == Abilities::COMATOSE {
+                attacker_choice.base_power *= 2.0;
+            }
+        }
+        Choices::RAGINGBULL => {
+            attacker_choice.move_type = attacker.types.0;
+        }
+        Choices::SPRINGTIDESTORM => {
+            if state.weather_is_active(&Weather::RAIN)
+                || state.weather_is_active(&Weather::HEAVYRAIN)
+            {
+                attacker_choice.accuracy = 100.0;
+            }
+        }
+        Choices::BLIZZARD => {
+            if state.weather_is_active(&Weather::SNOW) {
+                attacker_choice.accuracy = 100.0;
+            }
+        }
+        Choices::WIDEGUARD => {
+            if !attacker_choice.first_move {
+                attacker_choice.remove_all_effects();
+            }
+        }
+        Choices::BUBBLEBLAST => {
+            if !defender.item_is_permanent() && defender.item != Items::NONE {
+                attacker_choice.base_power *= 1.5;
+            }
+        }
+        Choices::HEATUP => {
+            if !attacker.has_type(&PokemonType::FIRE) {
+                attacker_choice.base_power *= 2.0;
+            }
+        }
+        Choices::SONICSLASH => {
+            let atk_spe = attacking_side.calculate_boosted_stat(PokemonBoostableStat::Speed);
+            let def_spe = defending_side.calculate_boosted_stat(PokemonBoostableStat::Speed);
+            attacker_choice.base_power = if def_spe <= 0 {
+                80.0
+            } else {
+                let ratio = atk_spe / def_spe;
+                if ratio >= 3 {
+                    140.0
+                } else if ratio >= 2 {
+                    120.0
+                } else {
+                    80.0
+                }
+            };
+        }
+        _ => {}
+    }
+}
