+#![allow(unused_variables)]
+use super::abilities::{ignores_target_ability, Abilities};
+use super::damage_calc::{damage_parts, type_effectiveness_modifier};
+use super::generate_instructions::{add_remove_status_instructions, apply_boost_instruction};
+use super::items::get_choice_move_disable_instructions;
+use super::state::{MoveChoice, PokemonVolatileStatus, Weather};
+use crate::choices::{
+    Choice, Choices, Effect, MoveCategory, MoveTarget, MultiAccuracyMove, MultiHitMove, Secondary,
+};
+use crate::instruction::{
+    ApplyVolatileStatusInstruction, BoostInstruction, ChangeAbilityInstruction, ChangeType,
+    FormeChangeInstruction, HealInstruction, Instruction, StateInstructions,
+};
+use crate::pokemon::PokemonName;
+use crate::state::{
+    LastUsedMove, Pokemon, PokemonBoostableStat, PokemonStatus, PokemonType, Side, SideReference,
+    State,
+};
+use std::cmp;
+
+/// Showdown's 4096-scale modifier (half-down rounding: `tr((val * mod + 2047) / 4096)`).
+#[inline]
+pub fn chain_modify_i16(value: i16, numerator: i32) -> i16 {
+    (((value as i32) * numerator + 2047) / 4096).max(1) as i16
+}
+
+#[inline]
+pub fn chain_modify_bp(bp: f32, numerator: i32) -> f32 {
+    if bp <= 0.0 {
+        return bp;
+    }
+    ((((bp as i32) * numerator + 2047) / 4096).max(1)) as f32
+}
+
+pub fn is_bone_move(move_id: Choices) -> bool {
+    matches!(
+        move_id,
+        Choices::BONECLUB | Choices::BONEMERANG | Choices::BONERUSH | Choices::SHADOWBONE
+    )
+}
+
+pub fn is_kick_move(move_id: Choices) -> bool {
+    matches!(
+        move_id,
+        Choices::BLAZEKICK
+            | Choices::DOUBLEKICK
+            | Choices::HIGHHORSEPOWER
+            | Choices::HIGHJUMPKICK
+            | Choices::JUMPKICK
+            | Choices::LOWKICK
+            | Choices::LOWSWEEP
+            | Choices::MEGAKICK
+            | Choices::PYROBALL
+            | Choices::ROLLINGKICK
+            | Choices::STOMP
+            | Choices::TRIPLEARROWS
+            | Choices::TRIPLEAXEL
+            | Choices::TRIPLEKICK
+            | Choices::TROPKICK
+    )
+}
+
+pub fn bone_zone_ignores_ground_immunity(attacker: &Pokemon, choice: &Choice) -> bool {
+    attacker.ability == Abilities::BONEZONE
+        && choice.move_type == PokemonType::GROUND
+        && is_bone_move(choice.move_id)
+}
+
+pub fn rr_blocks_boost(
+    target_ability: Abilities,
+    boost: i8,
+    attacking_side_ref: &SideReference,
+    target_side_ref: &SideReference,
+) -> bool {
+    // Bad Company: prevents self-lowering stat drops (opponent drops still apply).
+    target_ability == Abilities::BADCOMPANY && attacking_side_ref == target_side_ref && boost < 0
+}
+
+pub fn rr_ability_before_move(
+    state: &mut State,
+    choice: &mut Choice,
+    side_ref: &SideReference,
+    instructions: &mut StateInstructions,
+) {
+    let (attacking_side, defending_side) = state.get_both_sides(side_ref);
+    if defending_side.get_active_immutable().ability == Abilities::NEUTRALIZINGGAS {
+        return;
+    }
+    let active_pkmn = attacking_side.get_active();
+    match active_pkmn.ability {
+        Abilities::PROTEAN | Abilities::LIBERO => {
+            // Radical Red reverts Gen 9 nerf: activates on every move (not once per switch-in),
+            // and changes type whenever current types != (move_type, TYPELESS).
+            if choice.move_type != PokemonType::TYPELESS
+                && active_pkmn.types != (choice.move_type, PokemonType::TYPELESS)
+                && !active_pkmn.terastallized
+            {
+                instructions
+                    .instruction_list
+                    .push(Instruction::ChangeType(ChangeType {
+                        side_ref: *side_ref,
+                        new_types: (choice.move_type, PokemonType::TYPELESS),
+                        old_types: active_pkmn.types,
+                    }));
+                active_pkmn.types = (choice.move_type, PokemonType::TYPELESS);
+                if !attacking_side
+                    .volatile_statuses
+                    .contains(&PokemonVolatileStatus::TYPECHANGE)
+                {
+                    instructions
+                        .instruction_list
+                        .push(Instruction::ApplyVolatileStatus(
+                            ApplyVolatileStatusInstruction {
+                                side_ref: *side_ref,
+                                volatile_status: PokemonVolatileStatus::TYPECHANGE,
+                            },
+                        ));
+                    attacking_side
+                        .volatile_statuses
+                        .insert(PokemonVolatileStatus::TYPECHANGE);
+                }
+            }
+        }
+        Abilities::SAGEPOWER => {
+            if choice.move_id != Choices::STRUGGLE {
+                let ins =
+                    get_choice_move_disable_instructions(active_pkmn, side_ref, &choice.move_id);
+                for i in ins {
+                    state.apply_one_instruction(&i);
+                    instructions.instruction_list.push(i);
+                }
+            }
+        }
+        _ => {}
+    }
+}
+
+pub fn rr_ability_after_damage_hit(
+    state: &mut State,
+    _choice: &mut Choice,
+    side_ref: &SideReference,
+    damage_dealt: i16,
+    instructions: &mut StateInstructions,
+) {
+    let (attacking_side, defending_side) = state.get_both_sides(side_ref);
+    let active_pkmn = attacking_side.get_active();
+    if defending_side.get_active_immutable().ability == Abilities::NEUTRALIZINGGAS
+        || active_pkmn.ability == Abilities::NEUTRALIZINGGAS
+    {
+        return;
+    }
+    match active_pkmn.ability {
+        Abilities::BATTLEBOND => {
+            // Radical Red uses Gen 7/8 Ash-Greninja forme change on KO while foe has mons left.
+            if damage_dealt > 0
+                && defending_side.get_active_immutable().hp == 0
+                && active_pkmn.id == PokemonName::GRENINJABOND
+                && active_pkmn.hp > 0
+                && defending_side.visible_alive_pkmn() > 0
+            {
+                instructions
+                    .instruction_list
+                    .push(Instruction::FormeChange(FormeChangeInstruction {
+                        side_ref: *side_ref,
+                        name_change: PokemonName::GRENINJAASH as i16 - active_pkmn.id as i16,
+                    }));
+                active_pkmn.id = PokemonName::GRENINJAASH;
+                active_pkmn.recalculate_stats(side_ref, instructions);
+            }
+        }
+        _ => {}
+    }
+}
+
+pub fn rr_ability_end_of_turn(
+    state: &mut State,
+    side_ref: &SideReference,
+    instructions: &mut StateInstructions,
+) {
+    let (attacking_side, defending_side) = state.get_both_sides(side_ref);
+    if defending_side.get_active_immutable().ability == Abilities::NEUTRALIZINGGAS {
+        return;
+    }
+    let active_pkmn = attacking_side.get_active();
+    match active_pkmn.ability {
+        Abilities::SELFSUFFICIENT => {
+            let health_recovered =
+                cmp::min(active_pkmn.maxhp / 16, active_pkmn.maxhp - active_pkmn.hp);
+            if health_recovered > 0 {
+                instructions
+                    .instruction_list
+                    .push(Instruction::Heal(HealInstruction {
+                        side_ref: *side_ref,
+                        heal_amount: health_recovered,
+                    }));
+                active_pkmn.hp += health_recovered;
+            }
+        }
+        _ => {}
+    }
+}
+
+pub fn rr_ability_on_switch_in(
+    state: &mut State,
+    side_ref: &SideReference,
+    instructions: &mut StateInstructions,
+) {
+    let (attacking_side, defending_side) = state.get_both_sides(side_ref);
+    if defending_side.get_active_immutable().ability == Abilities::NEUTRALIZINGGAS {
+        return;
+    }
+    let active_index = attacking_side.active_index;
+    let active_ability = attacking_side.get_active_immutable().ability;
+    match active_ability {
+        Abilities::CASHSPLASH => {
+            if attacking_side.get_active_immutable().status == PokemonStatus::BURN {
+                add_remove_status_instructions(
+                    instructions,
+                    active_index,
+                    *side_ref,
+                    attacking_side,
+                );
+            }
+        }
+        Abilities::CHILLLIKETHAT => {
+            apply_boost_instruction(
+                attacking_side,
+                &PokemonBoostableStat::Attack,
+                &6,
+                side_ref,
+                side_ref,
+                instructions,
+            );
+        }
+        Abilities::ZENMODE => {
+            // Radical Red: Darmanitan / Darmanitan-Galar enter Zen Mode immediately on switch-in.
+            let active_pkmn = attacking_side.get_active();
+            let target = match active_pkmn.id {
+                PokemonName::DARMANITAN => Some((
+                    PokemonName::DARMANITANZEN,
+                    (PokemonType::FIRE, PokemonType::PSYCHIC),
+                )),
+                PokemonName::DARMANITANGALAR => Some((
+                    PokemonName::DARMANITANGALARZEN,
+                    (PokemonType::ICE, PokemonType::FIRE),
+                )),
+                _ => None,
+            };
+            if let Some((new_forme, new_types)) = target {
+                instructions
+                    .instruction_list
+                    .push(Instruction::FormeChange(FormeChangeInstruction {
+                        side_ref: *side_ref,
+                        name_change: new_forme as i16 - active_pkmn.id as i16,
+                    }));
+                active_pkmn.id = new_forme;
+                if active_pkmn.types != new_types {
+                    instructions
+                        .instruction_list
+                        .push(Instruction::ChangeType(ChangeType {
+                            side_ref: *side_ref,
+                            new_types,
+                            old_types: active_pkmn.types,
+                        }));
+                    active_pkmn.types = new_types;
+                }
+                active_pkmn.recalculate_stats(side_ref, instructions);
+            }
+        }
+        Abilities::SCHOOLING => {
+            let active_pkmn = attacking_side.get_active();
+            if active_pkmn.level >= 20 {
+                if active_pkmn.hp > active_pkmn.maxhp / 4
+                    && active_pkmn.id == PokemonName::WISHIWASHI
+                {
+                    instructions
+                        .instruction_list
+                        .push(Instruction::FormeChange(FormeChangeInstruction {
+                            side_ref: *side_ref,
+                            name_change: PokemonName::WISHIWASHISCHOOL as i16
+                                - active_pkmn.id as i16,
+                        }));
+                    active_pkmn.id = PokemonName::WISHIWASHISCHOOL;
+                    active_pkmn.recalculate_stats(side_ref, instructions);
+                } else if active_pkmn.hp <= active_pkmn.maxhp / 4
+                    && active_pkmn.id == PokemonName::WISHIWASHISCHOOL
+                {
+                    instructions
+                        .instruction_list
+                        .push(Instruction::FormeChange(FormeChangeInstruction {
+                            side_ref: *side_ref,
+                            name_change: PokemonName::WISHIWASHI as i16 - active_pkmn.id as i16,
+                        }));
+                    active_pkmn.id = PokemonName::WISHIWASHI;
+                    active_pkmn.recalculate_stats(side_ref, instructions);
+                }
+            }
+        }
+        _ => {}
+    }
+}
