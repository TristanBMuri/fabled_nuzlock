+// Both sides switching (Showdown): switches go in the order of the outgoing mons' speed
+// (reversed in Trick Room), and each runs its switch-in abilities / items before the other
+// side switches (runSwitch sorts ahead of the pending switch), so the first one's Intimidate
+// hits the mon that is about to leave.
+fn generate_instructions_from_double_switch(
+    state: &mut State,
+    side_one_index: PokemonIndex,
+    side_two_index: PokemonIndex,
+    incoming_instructions: &mut StateInstructions,
+) {
+    let s1 = get_effective_speed(state, &SideReference::SideOne);
+    let s2 = get_effective_speed(state, &SideReference::SideTwo);
+    let side_one_first = if state.trick_room.active { s1 < s2 } else { s1 > s2 };
+    let order = if side_one_first {
+        [(SideReference::SideOne, side_one_index), (SideReference::SideTwo, side_two_index)]
+    } else {
+        [(SideReference::SideTwo, side_two_index), (SideReference::SideOne, side_one_index)]
+    };
+    for (side_ref, index) in order {
+        generate_instructions_from_switch(state, index, side_ref, incoming_instructions);
+    }
+}
