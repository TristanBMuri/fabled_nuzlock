+// Crit chance from the crit stage (Showdown's critRatio): high-crit move, Scope Lens /
+// Razor Claw, Super Luck +1 each; Focus Energy, Leek (Farfetch'd line) +2.
+fn crit_rate(attacker_side: &Side, defender: &crate::state::Pokemon, choice: &Choice) -> f32 {
+    if defender.ability == Abilities::BATTLEARMOR || defender.ability == Abilities::SHELLARMOR {
+        return 0.0;
+    }
+    if choice.move_id.guaranteed_crit() {
+        return 1.0;
+    }
+    let attacker = attacker_side.get_active_immutable();
+    let stage = choice.move_id.increased_crit_ratio() as usize
+        + matches!(attacker.item, Items::SCOPELENS | Items::RAZORCLAW) as usize
+        + (attacker.ability == Abilities::SUPERLUCK) as usize
+        + 2 * attacker_side
+            .volatile_statuses
+            .contains(&PokemonVolatileStatus::FOCUSENERGY) as usize
+        + 2 * (attacker.item == Items::LEEK
+            && matches!(
+                attacker.id,
+                crate::pokemon::PokemonName::FARFETCHD
+                    | crate::pokemon::PokemonName::FARFETCHDGALAR
+                    | crate::pokemon::PokemonName::SIRFETCHD
+            )) as usize;
+    #[cfg(any(feature = "gen4", feature = "gen5"))]
+    let table = [BASE_CRIT_CHANCE, 1.0 / 8.0, 1.0 / 4.0, 1.0 / 3.0, 1.0 / 2.0];
+    #[cfg(not(any(feature = "gen4", feature = "gen5")))]
+    let table = [BASE_CRIT_CHANCE, 1.0 / 8.0, 1.0 / 2.0, 1.0];
+    table[stage.min(table.len() - 1)]
+}
