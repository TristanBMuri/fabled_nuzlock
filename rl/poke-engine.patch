+#![cfg(feature = "rr")]
+
+use poke_engine::choices::Choices;
+use poke_engine::engine::abilities::Abilities;
+use poke_engine::engine::generate_instructions::generate_instructions_from_move_pair;
+use poke_engine::engine::items::Items;
+use poke_engine::engine::state::{MoveChoice, PokemonVolatileStatus, Terrain, Weather};
+use poke_engine::instruction::{
+    ApplyVolatileStatusInstruction, BoostInstruction, ChangeItemInstruction, DamageInstruction,
+    HealInstruction, Instruction, StateInstructions,
+};
+use poke_engine::pokemon::PokemonName;
+use poke_engine::state::{
+    LastUsedMove, PokemonBoostableStat, PokemonIndex, PokemonMoveIndex, PokemonType, SideReference,
+    State,
+};
+
+fn run_turn(
+    state: &mut State,
+    s1: &MoveChoice,
+    s2: &MoveChoice,
+    branch_on_damage: bool,
+) -> Vec<StateInstructions> {
+    state.set_conditional_mechanics();
+    let before = format!("{:?}", state);
+    let ins = generate_instructions_from_move_pair(state, s1, s2, branch_on_damage);
+    let after = format!("{:?}", state);
+    assert_eq!(before, after, "state was not cleanly reversed");
+    ins
+}
+
+#[test]
+fn test_speedboost_triggers_after_move_from_switch_state() {
+    // Yanma switched in previously (moveActions == 0 -> LastUsedMove::Switch(P0)) and uses a move
+    // while opponent switches: Showdown gives Yanma +1 Speed at end of turn.
+    let mut state = State::default();
+    state.side_two.get_active().ability = Abilities::SPEEDBOOST;
+    state.side_two.last_used_move = LastUsedMove::Switch(PokemonIndex::P0);
+    state
+        .side_two
+        .get_active()
+        .replace_move(PokemonMoveIndex::M0, Choices::MEGADRAIN);
+
+    let ins = run_turn(
+        &mut state,
+        &MoveChoice::Switch(PokemonIndex::P1),
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+        false,
+    );
+    assert_eq!(ins.len(), 1);
+    assert!(ins[0].instruction_list.contains(&Instruction::Boost(
+        BoostInstruction {
+            side_ref: SideReference::SideTwo,
+            stat: PokemonBoostableStat::Speed,
+            amount: 1,
+        }
+    )));
+}
+
+#[test]
+fn test_speedboost_does_not_trigger_on_switch_in_turn() {
+    // Side one had previously used a move (LastUsedMove::Move(M0)), then switches to Ninjask
+    // (Speed Boost): Showdown does NOT boost Ninjask on its switch-in turn.
+    let mut state = State::default();
+    state.side_one.last_used_move = LastUsedMove::Move(PokemonMoveIndex::M0);
+    state.side_one.pokemon[PokemonIndex::P1].ability = Abilities::SPEEDBOOST;
+    state
+        .side_two
+        .get_active()
+        .replace_move(PokemonMoveIndex::M0, Choices::SPLASH);
+
+    let ins = run_turn(
+        &mut state,
