+/// Extra type effectiveness multiplier for moves like Divine Judgment (2x vs Ghost).
+pub fn rr_extra_type_effectiveness(choice: &Choice, defender: &Pokemon) -> f32 {
+    if choice.move_id == Choices::DIVINEJUDGMENT
+        && choice.move_type == PokemonType::NORMAL
+        && defender.has_type(&PokemonType::GHOST)
+    {
+        return 2.0;
+    }
+    1.0
+}
