+/// RR `choice_special_effect` hooks (Baton Pass, Cyro's Nest, Garama, Honey Sip, Self Tinker).
+pub fn rr_choice_special_effect(
+    state: &mut State,
+    choice: &mut Choice,
+    attacking_side_ref: &SideReference,
+    instructions: &mut StateInstructions,
+) {
+    match choice.move_id {
+        Choices::BATONPASS => {
+            let side = state.get_side(attacking_side_ref);
+            let spa = side.calculate_boosted_stat(PokemonBoostableStat::SpecialAttack) as f32;
+            let spd = side.calculate_boosted_stat(PokemonBoostableStat::SpecialDefense) as f32;
+            let active = side.get_active_immutable();
+            let eff = type_effectiveness_modifier(&PokemonType::NORMAL, active);
+            if eff == 0.0 || active.hp <= 0 {
+                return;
+            }
+            let stab = if active.has_type(&PokemonType::NORMAL) {
+                1.5
+            } else {
+                1.0
+            };
+            let mut base = (2.0 * active.level as f32).floor() / 5.0;
+            base = (base.floor() + 2.0) * 40.0 * spa / spd;
+            base = (base.floor() / 50.0).floor() + 2.0;
+            let mut dmg = ((base * 0.925).floor() * stab * eff).floor() as i16;
+            dmg = dmg.max(1).min(active.hp);
+            let active = side.get_active();
+            active.hp -= dmg;
+            instructions
+                .instruction_list
+                .push(Instruction::Damage(DamageInstruction {
+                    side_ref: *attacking_side_ref,
+                    damage_amount: dmg,
+                }));
+        }
+        Choices::CYROSNEST => {
+            let side = state.get_side(attacking_side_ref);
+            let active = side.get_active_immutable();
+            let chill_abil = Abilities::from_str("chilllikethat").unwrap_or(Abilities::NONE);
+            let has_chill = (chill_abil != Abilities::NONE && active.ability == chill_abil)
+                || active.id == PokemonName::CYROOST;
+            if has_chill && side.side_conditions.aurora_veil == 0 {
+                let dur = if active.item == Items::LIGHTCLAY { 8 } else { 5 };
+                instructions
+                    .instruction_list
+                    .push(Instruction::ChangeSideCondition(
+                        ChangeSideConditionInstruction {
+                            side_ref: *attacking_side_ref,
+                            side_condition: PokemonSideCondition::AuroraVeil,
+                            amount: dur,
+                        },
+                    ));
+                side.side_conditions.aurora_veil = dur;
+            }
+        }
+        Choices::GARAMA => {
+            if state
+                .get_side_immutable(attacking_side_ref)
+                .get_active_immutable()
+                .id
+                == PokemonName::HORNET
+            {
+                apply_forme_change_with_species_info(
+                    state,
+                    attacking_side_ref,
+                    PokemonName::HORNETAGRO,
+                    instructions,
+                );
+            }
+        }
+        Choices::HONEYSIP => {
+            let side = state.get_side(attacking_side_ref);
+            if side.get_active_immutable().item != Items::HONEY {
+                return;
+            }
+            let active_idx = side.active_index;
+            let active = side.get_active();
+            let heal_amount = cmp::min(active.maxhp / 2, active.maxhp - active.hp);
+            if heal_amount > 0 {
+                active.hp += heal_amount;
+                instructions
+                    .instruction_list
+                    .push(Instruction::Heal(HealInstruction {
+                        side_ref: *attacking_side_ref,
+                        heal_amount,
+                    }));
+            }
+            if active.status != PokemonStatus::NONE {
+                add_remove_status_instructions(
+                    instructions,
+                    active_idx,
+                    *attacking_side_ref,
+                    side,
+                );
+            }
+            let active = side.get_active();
+            active.item = Items::NONE;
+            instructions
+                .instruction_list
+                .push(Instruction::ChangeItem(ChangeItemInstruction {
+                    side_ref: *attacking_side_ref,
+                    current_item: Items::HONEY,
+                    new_item: Items::NONE,
+                }));
+        }
+        Choices::SELFTINKER => {
+            let side = state.get_side(attacking_side_ref);
+            let active = side.get_active();
+            let broken_abil = Abilities::from_str("brokenmetalbody").unwrap_or(Abilities::NONE);
+            let mut heal_factor = 0.5f32;
+            if active.ability != Abilities::FULLMETALBODY {
+                let old_abil = active.ability;
+                if (broken_abil != Abilities::NONE && old_abil == broken_abil)
+                    || (broken_abil == Abilities::NONE && active.id == PokemonName::CLEMETAL)
+                {
+                    heal_factor = 2.0 / 3.0;
+                }
+                instructions
+                    .instruction_list
+                    .push(Instruction::ChangeAbility(ChangeAbilityInstruction {
+                        side_ref: *attacking_side_ref,
+                        ability_change: Abilities::FULLMETALBODY as i16 - active.ability as i16,
+                    }));
+                active.ability = Abilities::FULLMETALBODY;
+                if active.base_ability != Abilities::FULLMETALBODY {
+                    instructions
+                        .instruction_list
+                        .push(Instruction::ChangeBaseAbility(ChangeAbilityInstruction {
+                            side_ref: *attacking_side_ref,
+                            ability_change: Abilities::FULLMETALBODY as i16
+                                - active.base_ability as i16,
+                        }));
+                    active.base_ability = Abilities::FULLMETALBODY;
+                }
+            }
+            let heal_amount = cmp::min(
+                (active.maxhp as f32 * heal_factor).round() as i16,
+                active.maxhp - active.hp,
+            );
+            if heal_amount > 0 {
+                active.hp += heal_amount;
+                instructions
+                    .instruction_list
+                    .push(Instruction::Heal(HealInstruction {
+                        side_ref: *attacking_side_ref,
+                        heal_amount,
+                    }));
+            }
+            apply_boost_instruction(
+                side,
+                &PokemonBoostableStat::Defense,
+                &1,
+                attacking_side_ref,
+                attacking_side_ref,
+                instructions,
+            );
+        }
+        _ => {}
+    }
+}
