+/// Helper to perform a species forme change (recalculating stats and updating types).
+fn apply_forme_change_with_species_info(
+    state: &mut State,
+    side_ref: &SideReference,
+    new_id: PokemonName,
+    instructions: &mut StateInstructions,
+) {
+    let active = state.get_side(side_ref).get_active();
+    if active.id == new_id {
+        return;
+    }
+    instructions
+        .instruction_list
+        .push(Instruction::FormeChange(FormeChangeInstruction {
+            side_ref: *side_ref,
+            name_change: new_id as i16 - active.id as i16,
+        }));
+    active.id = new_id;
+    active.recalculate_stats(side_ref, instructions);
+
+    if let Some(info) = rr_species_info(new_id) {
+        if info.types != active.types {
+            instructions
+                .instruction_list
+                .push(Instruction::ChangeType(ChangeType {
+                    side_ref: *side_ref,
+                    new_types: info.types,
+                    old_types: active.types,
+                }));
+            active.types = info.types;
+        }
+    }
+}
