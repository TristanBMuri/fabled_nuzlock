+        .replace_move(PokemonMoveIndex::M0, Choices::TACKLE);
+    state
+        .side_one
+        .get_active()
+        .replace_move(PokemonMoveIndex::M1, Choices::WATERGUN);
+    state.side_two.get_active().ability = Abilities::THELOOK;
+    state.side_one.last_used_move = LastUsedMove::Move(PokemonMoveIndex::M0);
+    state.set_conditional_mechanics();
+    assert!(state.use_last_used_move);
+
+    // M0 (Tackle) is filtered out from get_all_options, M1 (Water Gun) remains available.
+    let (s1_opts, _) = state.get_all_options();
+    assert!(!s1_opts.contains(&MoveChoice::Move(PokemonMoveIndex::M0)));
+    assert!(s1_opts.contains(&MoveChoice::Move(PokemonMoveIndex::M1)));
+
+    // If forced to use M0 again, The Look causes it to fail with no damage.
+    let ins = generate_instructions_with_state_assertion(
+        &mut state,
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+        &MoveChoice::Move(PokemonMoveIndex::M0),
+    );
+    assert!(!ins[0]
+        .instruction_list
+        .iter()
+        .any(|i| matches!(i, Instruction::Damage(_))));
+}
