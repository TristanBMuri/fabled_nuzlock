+// Switching (ai_switching.c: CalcMostSuitableMonToSwitchInto + ShouldSwitch)
+// ---------------------------------------------------------------------------
+
+fn switch_in_score(
+    state: &mut State,
+    side: SideReference,
+    bench_idx: PokemonIndex,
+) -> (i32, SwitchFlags) {
+    with_bench_active(state, side, bench_idx, |st| {
+        let foe_side_ref = side.get_other_side();
+        let (my_side, foe_side) = st.get_both_sides_immutable(&side);
+        let mon = my_side.get_active_immutable();
+        let foe = foe_side.get_active_immutable();
+        let foe_hp = hp_frac(foe);
+        let my_hp = hp_frac(mon);
+
+        let mut score: i32 = 0;
+        let mut flags = SwitchFlags::default();
+
+        if get_effective_speed(st, &side) >= get_effective_speed(st, &foe_side_ref) {
+            score += 14;
+            flags.outspeeds = true;
+        }
+        let has_attacks = attacks_of(mon).next().is_some();
+        if can_ko(st, side, 1.0) {
+            score += 31;
+            flags.ko = true;
+            if attacks_of(mon).any(|c| c.priority > 0 && hit_frac(st, side, c) >= foe_hp) {
+                score += 8;
+                flags.revenge = true;
+                if !flags.outspeeds {
+                    score += 14;
+                    flags.outspeeds = true;
+                }
+            }
+        } else if can_ko(st, side, 2.0) {
+            score += 2;
+            flags.two_hko = true;
+        } else if !has_attacks {
+            return (-1, flags);
+        }
+
+        let mut foe_attacks: Vec<&Choice> = attacks_of(foe).collect();
+        foe_attacks.sort_by(|a, b| b.priority.cmp(&a.priority));
+        let mut faints = false;
+        let mut weak = false;
+        let mut normal = 0;
+        for c in &foe_attacks {
+            let d = hit_frac(st, foe_side_ref, c);
+            if d >= my_hp {
+                faints = true;
+                if flags.outspeeds && c.priority > 0 {
+                    flags.outspeeds = false;
+                }
+                break;
+            }
+            if 2.0 * d >= my_hp {
+                weak = true;
+            } else if 3.0 * d >= my_hp {
+                normal += 1;
+            }
+        }
+
+        if faints && !flags.outspeeds {
+            score = (score - 39).max(0);
+            flags.faints = true;
+        } else if faints && !flags.ko {
+            score = (score - 15).max(0);
+        } else if faints || weak {
+            score = (score - 1).max(0);
+        } else if normal == 0 {
+            score += 17;
+            flags.resists = true;
+        } else {
+            let phys = foe_attacks
+                .iter()
+                .any(|c| c.category == MoveCategory::Physical);
+            let spec = foe_attacks
+                .iter()
+                .any(|c| c.category == MoveCategory::Special);
+            let foe_atk = foe_side.calculate_boosted_stat(PokemonBoostableStat::Attack);
+            let foe_spa = foe_side.calculate_boosted_stat(PokemonBoostableStat::SpecialAttack);
+            if !(phys && mon.defense <= foe_atk) && !(spec && mon.special_defense <= foe_spa) {
+                score += 2;
+                flags.walls = true;
+            }
+        }
+        (score, flags)
+    })
+}
+
+fn ranked_switches(
+    state: &mut State,
+    side: SideReference,
+    avail_switches: &[PokemonIndex],
+) -> Vec<RankedSwitch> {
+    let mut rows: Vec<RankedSwitch> = avail_switches
+        .iter()
+        .map(|&idx| {
+            let (score, flags) = switch_in_score(state, side, idx);
+            RankedSwitch {
+                index: idx,
+                score,
+                flags,
+            }
+        })
+        .collect();
+    rows.sort_by(|a, b| {
+        b.score
+            .cmp(&a.score)
+            .then_with(|| a.flags.faints.cmp(&b.flags.faints))
+    });
+    rows
+}
+
+fn wont_take_much(
+    state: &mut State,
+    side: SideReference,
+    cand: RankedSwitch,
+    foe_move: Option<&Choice>,
+) -> bool {
+    if cand.flags.faints {
+        return false;
+    }
+    let Some(fm) = foe_move else {
+        return true;
+    };
+    if cand.flags.resists || fm.move_id == Choices::SUCKERPUNCH {
+        return true;
+    }
+    with_bench_active(state, side, cand.index, |st| {
+        let foe_side_ref = side.get_other_side();
+        let mon = st.get_side_immutable(&side).get_active_immutable();
+        let d = hit_frac(st, foe_side_ref, fm);
+        let hp = hp_frac(mon);
+        if d >= hp {
+            return false;
+        }
+        if 2.0 * d < hp {
+            return true;
+        }
+        let has_heal = mon
+            .moves
+            .into_iter()
+            .any(|m| m.id != Choices::NONE && is_recovery_move(&m.choice));
+        2.0 * d >= 1.0
+            && has_heal
+            && get_effective_speed(st, &side) > get_effective_speed(st, &foe_side_ref)
+    })
+}
+
+fn switch_target(
+    state: &mut State,
+    side: SideReference,
+    best_score: i32,
+    ranked: &[RankedSwitch],
+) -> Option<Vec<MoveChoice>> {
+    let foe_side_ref = side.get_other_side();
+    let foe_move_owned = predict_foe_move(state, side).cloned();
+    let foe_move = foe_move_owned.as_ref();
+
+    let (my_side, foe_side) = state.get_both_sides_immutable(&side);
+    let active = my_side.get_active_immutable();
+    let foe_active_clone = foe_side.get_active_immutable().clone();
+    let fresh = is_first_turn(my_side);
+    let ability = active.ability;
+    let active_hp = hp_frac(active);
+    let active_status = active.status;
+    let toxic_count = my_side.side_conditions.toxic_count;
+    let boosted = my_side.attack_boost > 0
+        || my_side.defense_boost > 0
+        || my_side.special_attack_boost > 0
+        || my_side.special_defense_boost > 0
+        || my_side.speed_boost > 0
+        || my_side.accuracy_boost > 0
+        || my_side.evasion_boost > 0;
+    let atk_boost = my_side.attack_boost;
+    let spa_boost = my_side.special_attack_boost;
+
+    let n_attacks = attacks_of(active).count();
+    let damager = n_attacks >= 3;
+    let has_phys = attacks_of(active).any(|c| c.category == MoveCategory::Physical);
+    let has_spec = attacks_of(active).any(|c| c.category == MoveCategory::Special);
+    let active_heals = active
+        .moves
+        .into_iter()
+        .any(|m| m.id != Choices::NONE && is_recovery_move(&m.choice));
+    let active_setup = active
+        .moves
+        .into_iter()
+        .any(|m| m.id != Choices::NONE && self_boosts(&m.choice).is_some());
+
+    let we_ko = can_ko(state, side, 1.0);
+    let foe_hit_active = foe_move.map_or(0.0, |fm| hit_frac(state, foe_side_ref, fm));
+    let they_ko = foe_move.is_some() && foe_hit_active >= active_hp;
+    let faster = get_effective_speed(state, &side) > get_effective_speed(state, &foe_side_ref);
+    let top2 = &ranked[..ranked.len().min(2)];
+
+    // 1. Absorb the predicted move (Flash Fire, Volt/Water Absorb, Dry Skin, Sap Sipper...)
+    if let Some(fm) = foe_move {
+        let mtype = fm.move_type;
+        let has_absorber_type = matches!(
+            mtype,
+            PokemonType::FIRE | PokemonType::ELECTRIC | PokemonType::WATER | PokemonType::GRASS
+        );
+        if has_absorber_type
+            && !fresh
+            && !ability_absorbs_type(ability, mtype)
+            && !(faster && we_ko)
+            && !(!they_ko && we_ko && boosted)
+        {
+            for &cand in ranked {
+                let mon = &state.get_side_immutable(&side).pokemon[cand.index];
+                if ability_absorbs_type(mon.ability, mtype) {
+                    if hp_frac(mon) >= 1.0
+                        && matches!(
+                            mon.ability,
+                            Abilities::VOLTABSORB | Abilities::WATERABSORB | Abilities::DRYSKIN
+                        )
+                        && 2.0 * foe_hit_active < active_hp
+                    {
+                        continue;
+                    }
+                    return Some(vec![MoveChoice::Switch(cand.index)]);
+                }
+            }
+        }
+    }
+
+    // 2. Only bad moves left: go to a top-2 mon that outspeeds/walls/resists and takes the hit
+    if best_score < BASE_SCORE && !fresh {
+        for &cand in top2 {
+            if cand.flags.outspeeds_walls_or_resists() && wont_take_much(state, side, cand, foe_move)
+            {
+                return Some(vec![MoveChoice::Switch(cand.index)]);
+            }
+        }
+    }
+
+    // 3. Annoying residual damage: Toxic past six turns
+    if active_status == PokemonStatus::TOXIC
+        && toxic_count > 6
+        && ability != Abilities::POISONHEAL
+        && !we_ko
+    {
+        return Some(top_tied_switches(ranked));
+    }
+
+    // 4. Avoid death: slower, predicted hit KOs, not nearly dead already
+    if !fresh
+        && they_ko
+        && !faster
+        && !(active_status == PokemonStatus::PARALYZE && active_hp < 1.0 / 3.0)
+        && (active_hp > 0.2 || ranked[0].score >= 70)
+    {
+        for &cand in ranked {
+            let immune_in = foe_move.map_or(false, |fm| {
+                let mon = &state.get_side_immutable(&side).pokemon[cand.index];
+                is_immune_damaging(&foe_active_clone, mon, fm)
+            });
+            if (cand.flags.outspeeds_walls_or_resists() && immune_in)
+                || ((cand.flags.walls_or_resists() || (cand.flags.ko && cand.flags.outspeeds))
+                    && wont_take_much(state, side, cand, foe_move))
+            {
+                return Some(vec![MoveChoice::Switch(cand.index)]);
+            }
+        }
+    }
+
+    // 5. Offensive stats at -3 with only that kind of attack, and foe cannot KO
+    let foe_can_ko = can_ko(state, foe_side_ref, 1.0);
+    if !fresh && damager {
+        let low = (atk_boost <= -3 && has_phys && !has_spec)
+            || (spa_boost <= -3 && has_spec && !has_phys)
+            || (atk_boost <= -3 && spa_boost <= -3);
+        if low && !foe_can_ko {
+            let cand = ranked[0];
+            if cand.flags.walls_or_resists()
+                || (cand.flags.outspeeds && wont_take_much(state, side, cand, foe_move))
+            {
+                return Some(vec![MoveChoice::Switch(cand.index)]);
+            }
+        }
+    }
+
+    // 6. Save the sweeper for later (deterministic part; CFRU's random 25/50% branch omitted)
+    if !fresh
+        && damager
+        && !we_ko
+        && !matches!(active_status, PokemonStatus::FREEZE | PokemonStatus::PARALYZE)
+    {
+        if (foe_can_ko && !active_heals) || (!boosted && !active_setup && ranked[0].flags.ko) {
+            if foe_can_ko {
+                for &cand in top2 {
+                    if cand.flags.ko
+                        && cand.flags.outspeeds
+                        && wont_take_much(state, side, cand, foe_move)
+                    {
+                        return Some(vec![MoveChoice::Switch(cand.index)]);
+                    }
+                }
+            }
+            for &cand in ranked {
+                if cand.flags.resists {
+                    return Some(vec![MoveChoice::Switch(cand.index)]);
+                }
+            }
+        }
+    }
+
+    None
+}
