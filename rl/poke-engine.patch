+pub fn rr_modify_defending_types(
+    attacking_pkmn: &Pokemon,
+    attacking_choice: &Choice,
+    defender_types: &mut (PokemonType, PokemonType),
+) {
+    if attacking_pkmn.ability == Abilities::CORROSION
+        && attacking_choice.move_type == PokemonType::POISON
+    {
+        if defender_types.0 == PokemonType::STEEL {
+            defender_types.0 = PokemonType::TYPELESS;
+        }
+        if defender_types.1 == PokemonType::STEEL {
+            defender_types.1 = PokemonType::TYPELESS;
+        }
+    }
+    if attacking_pkmn.ability == Abilities::BONEZONE && is_bone_move(attacking_choice.move_id) {
+        // Bone Zone: bone moves ignore type immunities (Ground -> Flying, Ghost -> Normal).
+        let immune_type = match attacking_choice.move_type {
+            PokemonType::GROUND => Some(PokemonType::FLYING),
+            PokemonType::GHOST => Some(PokemonType::NORMAL),
+            PokemonType::NORMAL | PokemonType::FIGHTING => Some(PokemonType::GHOST),
+            PokemonType::ELECTRIC => Some(PokemonType::GROUND),
+            PokemonType::POISON => Some(PokemonType::STEEL),
+            PokemonType::PSYCHIC => Some(PokemonType::DARK),
+            PokemonType::DRAGON => Some(PokemonType::FAIRY),
+            _ => None,
+        };
+        if let Some(immune) = immune_type {
+            if defender_types.0 == immune {
+                defender_types.0 = PokemonType::TYPELESS;
+            }
+            if defender_types.1 == immune {
+                defender_types.1 = PokemonType::TYPELESS;
+            }
+        }
+    }
+}
