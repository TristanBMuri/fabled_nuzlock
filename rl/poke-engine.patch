+pub fn rr_damage_modifier(
+    attacker: &Pokemon,
+    defender: &Pokemon,
+    choice: &Choice,
+    type_eff: f32,
+) -> f32 {
+    let mut modifier = 1.0;
+    if attacker.ability == Abilities::NEUTRALIZINGGAS
+        || defender.ability == Abilities::NEUTRALIZINGGAS
+    {
+        return modifier;
+    }
+    match attacker.ability {
+        Abilities::BONEZONE => {
+            if is_bone_move(choice.move_id) && type_eff > 0.0 && type_eff < 1.0 {
+                modifier *= 2.0;
+            }
+        }
+        Abilities::JUMPSCARE => {
+            if choice.category != MoveCategory::Status {
+                modifier *= 5324.0 / 4096.0;
+            }
+        }
+        _ => {}
+    }
+    if !ignores_target_ability(attacker, choice, &defender.ability) {
+        match defender.ability {
+            Abilities::BLUBBERDEFENSE => {
+                if defender.hp >= defender.maxhp {
+                    modifier *= 0.5;
+                }
+            }
+            Abilities::PRIMALARMOR => {
+                if type_eff > 1.0 {
+                    modifier *= 0.5;
+                }
+            }
+            Abilities::VOCALIZER => {
+                if choice.flags.sound {
+                    modifier *= 0.5;
+                }
+            }
+            Abilities::WATERCOMPACTION => {
+                if choice.move_type == PokemonType::WATER {
+                    modifier *= 0.5;
+                }
+            }
+            _ => {}
+        }
+    }
+    modifier
+}
