+#[test]
+fn test_badcompany_blocks_self_stat_drops_and_recoil_and_mindblown() {
+    // Self stat drops blocked (Close Combat), opponent drops still apply (Growl).
+    let mut state = State::default();
+    state.side_one.get_active().ability = Abilities::BADCOMPANY;
+    state.side_two.get_active().hp = 300;
+    state.side_two.get_active().maxhp = 300;
+    let ins = run_moves(&mut state, Choices::CLOSECOMBAT, Choices::GROWL);
+    assert_eq!(ins.len(), 1);
+    let list = &ins[0].instruction_list;
+    // No self Defense/SpD drops on SideOne; Growl's -1 Attack from SideTwo still applies.
+    assert!(!list.iter().any(|i| matches!(
+        i,
+        Instruction::Boost(BoostInstruction {
+            side_ref: SideReference::SideOne,
+            stat: PokemonBoostableStat::Defense | PokemonBoostableStat::SpecialDefense,
+            ..
+        })
+    )));
+    assert!(list.contains(&Instruction::Boost(BoostInstruction {
+        side_ref: SideReference::SideOne,
+        stat: PokemonBoostableStat::Attack,
+        amount: -1,
+    })));
+
+    // Recoil prevented (Double-Edge).
+    let mut state = State::default();
+    state.side_one.get_active().ability = Abilities::BADCOMPANY;
+    state.side_two.get_active().hp = 300;
+    state.side_two.get_active().maxhp = 300;
+    let ins = run_moves(&mut state, Choices::DOUBLEEDGE, Choices::SPLASH);
+    assert_eq!(ins.len(), 1);
+    assert!(!ins[0].instruction_list.iter().any(|i| matches!(
+        i,
+        Instruction::Damage(DamageInstruction {
+            side_ref: SideReference::SideOne,
+            ..
+        })
+    )));
+
+    // Mind Blown recoil prevented.
+    let mut state = State::default();
+    state.side_one.get_active().ability = Abilities::BADCOMPANY;
+    state.side_two.get_active().hp = 300;
+    state.side_two.get_active().maxhp = 300;
+    let ins = run_moves(&mut state, Choices::MINDBLOWN, Choices::SPLASH);
+    assert_eq!(ins.len(), 1);
+    assert!(!ins[0].instruction_list.iter().any(|i| matches!(
+        i,
+        Instruction::Damage(DamageInstruction {
+            side_ref: SideReference::SideOne,
+            ..
+        })
+    )));
+}
