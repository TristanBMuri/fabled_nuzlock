+pub fn target(species: P, item: Items) -> Option<MegaEvolveData> {
+    MEGAS
+        .iter()
+        .find(|m| m.0 == species && m.1 == item)
+        .map(|m| MegaEvolveData { id: m.2, types: (m.3, m.4), ability: m.5, base_stats: m.6 })
+}
+
+pub fn base_stats(mega: P) -> Option<(i16, i16, i16, i16, i16, i16)> {
+    MEGAS.iter().find(|m| m.2 == mega).map(|m| m.6)
+}
+
+pub fn is_stone(item: Items) -> bool {
+    MEGAS.iter().any(|m| m.1 == item)
+}
+
+/// Mega Rayquaza: Dragon Ascent among its moves, any item (the mod's canMegaEvo; a Z crystal would
+/// block it, the converter drops those). Stats, types and ability as in the dex (RR keeps them).
+pub fn rayquaza(p: &Pokemon) -> Option<MegaEvolveData> {
+    let ascent = p.moves.into_iter().any(|m| m.id == Choices::DRAGONASCENT);
+    (p.id == P::RAYQUAZA && ascent).then(|| MegaEvolveData {
+        id: P::RAYQUAZAMEGA,
+        types: (T::DRAGON, T::FLYING),
+        ability: Abilities::DELTASTREAM,
+        base_stats: (105, 180, 100, 180, 100, 115),
+    })
+}
