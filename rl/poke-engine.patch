+pub fn rr_ability_modify_attack_against(
+    state: &State,
+    attacker_choice: &mut Choice,
+    defender_choice: &Choice,
+    attacking_side_ref: &SideReference,
+) {
+    let (attacking_side, defending_side) = state.get_both_sides_immutable(attacking_side_ref);
+    let attacking_pkmn = attacking_side.get_active_immutable();
+    let target_pkmn = defending_side.get_active_immutable();
+    if target_pkmn.ability == Abilities::NEUTRALIZINGGAS
+        || attacker_choice.target == MoveTarget::User
+    {
+        return;
+    }
+    if ignores_target_ability(attacking_pkmn, attacker_choice, &target_pkmn.ability) {
+        return;
+    }
+    match target_pkmn.ability {
+        Abilities::ICEBODY => {
+            if attacker_choice.flags.contact {
+                attacker_choice.add_or_create_secondaries(Secondary {
+                    chance: 30.0,
+                    target: MoveTarget::User,
+                    effect: Effect::Status(PokemonStatus::FREEZE),
+                });
+            }
+        }
+        Abilities::MOUNTAINEER => {
+            if attacker_choice.move_type == PokemonType::ROCK {
+                attacker_choice.remove_all_effects();
+                attacker_choice.accuracy = 0.0;
+            }
+        }
+        Abilities::UNBOTHERED => {
+            if attacker_choice.move_id == Choices::TAUNT {
+                attacker_choice.remove_all_effects();
+            }
+            if let Some(vs) = &attacker_choice.volatile_status {
+                if vs.target == MoveTarget::Opponent
+                    && matches!(
+                        vs.volatile_status,
+                        PokemonVolatileStatus::FLINCH | PokemonVolatileStatus::TAUNT
+                    )
+                {
+                    attacker_choice.volatile_status = None;
+                }
+            }
+            if let Some(secondaries) = &mut attacker_choice.secondaries {
+                for sec in secondaries.iter_mut() {
+                    if sec.target == MoveTarget::Opponent
+                        && matches!(
+                            sec.effect,
+                            Effect::VolatileStatus(
+                                PokemonVolatileStatus::FLINCH | PokemonVolatileStatus::TAUNT
+                            )
+                        )
+                    {
+                        sec.chance = 0.0;
+                    }
+                }
+            }
+        }
+        _ => {}
+    }
+}
