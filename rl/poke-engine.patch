+// Negatives (AIScript_Negatives)
+// ---------------------------------------------------------------------------
+
+fn status_fails(state: &State, foe: &Pokemon, choice: &Choice) -> bool {
+    let Some(st) = &choice.status else {
+        return false;
+    };
+    if st.target != MoveTarget::Opponent {
+        return false;
+    }
+    if foe.status != PokemonStatus::NONE {
+        return true;
+    }
+    let ab = foe.ability;
+    let blocked_by_ab = match st.status {
+        PokemonStatus::PARALYZE => matches!(ab, Abilities::LIMBER | Abilities::COMATOSE),
+        PokemonStatus::BURN => matches!(
+            ab,
+            Abilities::WATERVEIL
+                | Abilities::WATERBUBBLE
+                | Abilities::COMATOSE
+                | Abilities::THERMALEXCHANGE
+        ),
+        PokemonStatus::POISON | PokemonStatus::TOXIC => {
+            matches!(ab, Abilities::IMMUNITY | Abilities::COMATOSE | Abilities::PASTELVEIL)
+        }
+        PokemonStatus::SLEEP => matches!(
+            ab,
+            Abilities::INSOMNIA
+                | Abilities::VITALSPIRIT
+                | Abilities::COMATOSE
+                | Abilities::SWEETVEIL
+                | Abilities::PURIFYINGSALT
+        ),
+        PokemonStatus::FREEZE => matches!(ab, Abilities::MAGMAARMOR | Abilities::COMATOSE),
+        PokemonStatus::NONE => false,
+    };
+    if blocked_by_ab {
+        return true;
+    }
+    match st.status {
+        PokemonStatus::POISON | PokemonStatus::TOXIC
+            if foe.has_type(&PokemonType::STEEL) || foe.has_type(&PokemonType::POISON) =>
+        {
+            return true;
+        }
+        PokemonStatus::BURN if foe.has_type(&PokemonType::FIRE) => return true,
+        PokemonStatus::FREEZE if foe.has_type(&PokemonType::ICE) => return true,
+        PokemonStatus::PARALYZE => {
+            if foe.has_type(&PokemonType::ELECTRIC)
+                || (choice.move_type == PokemonType::ELECTRIC && foe.has_type(&PokemonType::GROUND))
+            {
+                return true;
+            }
+        }
+        _ => {}
+    }
+    if state.terrain_is_active(&Terrain::MISTYTERRAIN) {
+        return true;
+    }
+    st.status == PokemonStatus::SLEEP && state.terrain_is_active(&Terrain::ELECTRICTERRAIN)
+}
+
+fn weather_already_up(state: &State, id: Choices) -> bool {
+    let w = state.get_weather();
+    match id {
+        Choices::SUNNYDAY => matches!(w, Weather::SUN | Weather::HARSHSUN),
+        Choices::RAINDANCE => matches!(w, Weather::RAIN | Weather::HEAVYRAIN),
+        Choices::SANDSTORM => w == Weather::SAND,
+        Choices::HAIL => w == Weather::HAIL,
+        Choices::SNOWSCAPE | Choices::CHILLYRECEPTION => w == Weather::SNOW,
+        _ => false,
+    }
+}
+
+fn terrain_already_up(state: &State, id: Choices) -> bool {
+    match id {
+        Choices::ELECTRICTERRAIN => state.terrain_is_active(&Terrain::ELECTRICTERRAIN),
+        Choices::GRASSYTERRAIN => state.terrain_is_active(&Terrain::GRASSYTERRAIN),
+        Choices::MISTYTERRAIN => state.terrain_is_active(&Terrain::MISTYTERRAIN),
+        Choices::PSYCHICTERRAIN => state.terrain_is_active(&Terrain::PSYCHICTERRAIN),
+        _ => false,
+    }
+}
+
+fn negatives(
+    state: &State,
+    side: SideReference,
+    choice: &Choice,
+    foe_move: Option<&Choice>,
+) -> i32 {
+    let (my_side, foe_side) = state.get_both_sides_immutable(&side);
+    let active = my_side.get_active_immutable();
+    let foe = foe_side.get_active_immutable();
+    let hp = hp_frac(active);
+
+    if is_first_turn_only(choice.move_id) && !is_first_turn(my_side) {
+        return -10;
+    }
+    if is_protect_move(choice.move_id) && my_side.side_conditions.protect > 0 {
+        return -10;
+    }
+    if choice.category != MoveCategory::Status && is_immune_damaging(active, foe, choice) {
+        return if is_absorb_ability(foe.ability) {
+            -20
+        } else {
+            -15
+        };
+    }
+    if choice.category == MoveCategory::Status && status_fails(state, foe, choice) {
+        return -10;
+    }
+    if choice.move_id == Choices::SUCKERPUNCH && foe_move.is_none() {
+        return -10;
+    }
+    if is_self_destruct(choice.move_id) && n_remaining(my_side) <= 1 {
+        return -10;
+    }
+    if let Some(b) = self_boosts(choice) {
+        let mut any_pos = false;
+        let mut all_maxed = true;
+        for (stat, val) in b.get_as_pokemon_boostable() {
+            if val > 0 {
+                any_pos = true;
+                if my_side.get_boost_from_boost_enum(&stat) < 6 {
+                    all_maxed = false;
+                }
+            }
+        }
+        if any_pos && all_maxed {
+            return -10;
+        }
+    }
+    if is_recovery_move(choice) {
+        if hp >= 1.0 {
+            return -10;
+        }
+        if hp >= 0.9 {
+            return -9;
+        }
+    }
+    if weather_already_up(state, choice.move_id) || terrain_already_up(state, choice.move_id) {
+        return -10;
+    }
+    if is_screen_move(choice.move_id) {
+        let sc = &my_side.side_conditions;
+        let already = match choice.move_id {
+            Choices::REFLECT => sc.reflect > 0,
+            Choices::LIGHTSCREEN => sc.light_screen > 0,
+            Choices::AURORAVEIL => sc.aurora_veil > 0,
+            _ => false,
+        };
+        if already {
+            return -10;
+        }
+    }
+    if is_hazard_move(choice.move_id) {
+        let fsc = &foe_side.side_conditions;
+        let full = match choice.move_id {
+            Choices::STEALTHROCK => fsc.stealth_rock >= 1,
+            Choices::SPIKES => fsc.spikes >= 3,
+            Choices::TOXICSPIKES => fsc.toxic_spikes >= 2,
+            Choices::STICKYWEB => fsc.sticky_web >= 1,
+            _ => false,
+        };
+        if full {
+            return -10;
+        }
+    }
+    if is_hazard_removal(choice.move_id) && !has_any_side_condition(&my_side.side_conditions) {
+        return -10;
+    }
+    if let Some(vs) = &choice.volatile_status {
+        if vs.target == MoveTarget::Opponent
+            && foe_side.volatile_statuses.contains(&vs.volatile_status)
+        {
+            return -10;
+        }
+    }
+    0
+}
+
+// ---------------------------------------------------------------------------
+// Positives (AIScript_Positives + DamageMoveViabilityIncrease)
+// ---------------------------------------------------------------------------
+
+fn status_viability(cls: FightingStyle, boost: i32, state: &State, side: SideReference) -> i32 {
+    match cls {
+        FightingStyle::SetupStats => {
+            if !can_ko(state, side.get_other_side(), 2.0) {
+                3
+            } else {
+                0
+            }
+        }
+        FightingStyle::SetupStatus | FightingStyle::Phazer => 4 + boost,
+        FightingStyle::Stall | FightingStyle::Cleric => 3 + boost,
+        FightingStyle::Screens | FightingStyle::ScreensSweeper => 2 + boost,
+        FightingStyle::Hazards => 3,
+        FightingStyle::BatonPass => i32::from(boost >= 3),
+        FightingStyle::Kill => 0,
+    }
+}
+
+fn bad_status(st: PokemonStatus, foe: &Pokemon, active: &Pokemon) -> bool {
+    let ab = foe.ability;
+    let foe_phys = attacks_of(foe).any(|c| c.category == MoveCategory::Physical);
+    if matches!(
+        ab,
+        Abilities::SHEDSKIN | Abilities::QUICKFEET | Abilities::NATURALCURE | Abilities::HYDRATION
+    ) || mon_has_move(foe, Choices::FACADE)
+        || mon_has_move(foe, Choices::PSYCHOSHIFT)
+    {
+        return true;
+    }
+    if ab == Abilities::GUTS && foe_phys {
+        return true;
+    }
+    if ab == Abilities::MARVELSCALE
+        && attacks_of(active).any(|c| c.category == MoveCategory::Physical)
+    {
+        return true;
+    }
+    match st {
+        PokemonStatus::POISON | PokemonStatus::TOXIC => {
+            matches!(ab, Abilities::POISONHEAL | Abilities::MAGICGUARD)
+                || (ab == Abilities::TOXICBOOST && foe_phys)
+        }
+        PokemonStatus::PARALYZE => mon_has_move(foe, Choices::REST),
+        PokemonStatus::BURN => {
+            ab == Abilities::MAGICGUARD
+                || (ab == Abilities::FLAREBOOST
+                    && attacks_of(foe).any(|c| c.category == MoveCategory::Special))
+        }
+        PokemonStatus::SLEEP => ab == Abilities::EARLYBIRD,
+        _ => false,
+    }
+}
+
+fn should_recover(
+    state: &State,
+    side: SideReference,
+    choice: &Choice,
+    foe_move: Option<&Choice>,
+    foe_best: f32,
+) -> bool {
+    let active = state.get_side_immutable(&side).get_active_immutable();
+    let hp = hp_frac(active);
+    let heal = heal_amount(choice).min(1.0 - hp);
+    if goes_first(state, side, choice, foe_move) {
+        if foe_best >= hp && foe_best < hp + heal {
+            return true;
+        }
+        // CFRU's 50% roll when 2*d >= hp && heal > hp is approximated deterministically as false.
+        return false;
+    }
+    foe_best < hp && 2.0 * foe_best >= hp && hp - foe_best + heal > foe_best
+}
+
+fn should_protect(state: &State, side: SideReference, foe_best: f32) -> bool {
+    let (my_side, foe_side) = state.get_both_sides_immutable(&side);
+    let active = my_side.get_active_immutable();
+    let foe = foe_side.get_active_immutable();
+    let dot_status = matches!(
+        foe.status,
+        PokemonStatus::POISON | PokemonStatus::TOXIC | PokemonStatus::BURN
+    );
+    let hurt = dot_status
+        || foe_side
+            .volatile_statuses
+            .contains(&PokemonVolatileStatus::LEECHSEED);
+    if dot_status && hp_frac(foe) <= 0.125 {
+        return true;
+    }
+    hurt && 2.0 * foe_best >= hp_frac(active)
+}
+
+fn setup_ok(
+    state: &State,
+    side: SideReference,
+    choice: &Choice,
+    foe_move: Option<&Choice>,
+    foe_best: f32,
+    stat: PokemonBoostableStat,
+    limit: i8,
+) -> bool {
+    let (my_side, foe_side) = state.get_both_sides_immutable(&side);
+    let active = my_side.get_active_immutable();
+    let foe = foe_side.get_active_immutable();
+    if foe.ability == Abilities::UNAWARE {
+        return false;
+    }
+    let hp = hp_frac(active);
+    if goes_first(state, side, choice, foe_move) {
+        if foe_best >= hp {
+            return false;
+        }
+    } else if 2.0 * foe_best >= hp {
+        let phys = foe_move.map_or(false, |c| c.category == MoveCategory::Physical);
+        return foe_best < hp
+            && ((stat == PokemonBoostableStat::Defense && phys)
+                || (stat == PokemonBoostableStat::SpecialDefense && !phys && foe_move.is_some()));
+    }
+    my_side.get_boost_from_boost_enum(&stat) < limit
+}
+
+fn stat_viability(
+    cls: FightingStyle,
+    state: &State,
+    side: SideReference,
+    choice: &Choice,
+    foe_move: Option<&Choice>,
+    foe_best: f32,
+    stat: PokemonBoostableStat,
+) -> i32 {
+    let ok = setup_ok(state, side, choice, foe_move, foe_best, stat, 2);
+    match cls {
+        FightingStyle::Kill | FightingStyle::SetupStats => {
+            if ok {
+                5
+            } else if cls == FightingStyle::Kill
+                && choice.category != MoveCategory::Status
+                && matches!(
+                    stat,
+                    PokemonBoostableStat::Attack | PokemonBoostableStat::SpecialAttack
+                )
+            {
+                1
+            } else {
+                0
+            }
+        }
+        FightingStyle::BatonPass => {
+            if ok {
+                5
+            } else {
+                0
+            }
+        }
+        _ => {
+            if ok {
+                status_viability(cls, 1, state, side)
+            } else {
+                0
+            }
+        }
+    }
+}
+
+fn good_to_raise(stat: PokemonBoostableStat, state: &State, side: SideReference) -> bool {
+    let (my_side, foe_side) = state.get_both_sides_immutable(&side);
+    let active = my_side.get_active_immutable();
+    let foe = foe_side.get_active_immutable();
+    match stat {
+        PokemonBoostableStat::Attack => {
+            attacks_of(active).any(|c| c.category == MoveCategory::Physical)
+        }
+        PokemonBoostableStat::SpecialAttack => {
+            attacks_of(active).any(|c| c.category == MoveCategory::Special)
+        }
+        PokemonBoostableStat::Defense => {
+            let fp = attacks_of(foe)
+                .filter(|c| c.category == MoveCategory::Physical)
+                .count();
+            let fs = attacks_of(foe)
+                .filter(|c| c.category == MoveCategory::Special)
+                .count();
+            fp > fs
+        }
+        PokemonBoostableStat::SpecialDefense => {
+            let fp = attacks_of(foe)
+                .filter(|c| c.category == MoveCategory::Physical)
+                .count();
+            let fs = attacks_of(foe)
+                .filter(|c| c.category == MoveCategory::Special)
+                .count();
+            fs > fp
+        }
+        PokemonBoostableStat::Speed => {
+            get_effective_speed(state, &side)
+                <= get_effective_speed(state, &side.get_other_side())
+        }
+        _ => false,
+    }
+}
+
+fn should_pivot(
+    state: &State,
+    side: SideReference,
+    choice: &Choice,
+    foe_move: Option<&Choice>,
+    foe_best: f32,
+    cls: FightingStyle,
+    ranked: &[RankedSwitch],
+) -> PivotDecision {
+    if ranked.is_empty() {
+        return PivotDecision::Try;
+    }
+    let my_side = state.get_side_immutable(&side);
+    let active = my_side.get_active_immutable();
+    let damager = matches!(
+        cls,
+        FightingStyle::Kill
+            | FightingStyle::SetupStats
+            | FightingStyle::SetupStatus
+            | FightingStyle::ScreensSweeper
+    );
+    let flags = ranked[0].flags;
+    let we_ko = can_ko(state, side, 1.0);
+    let we_2hko = can_ko(state, side, 2.0);
+    let hp = hp_frac(active);
+    let boosted = damager && (my_side.attack_boost > 0 || my_side.special_attack_boost > 0);
+
+    if goes_first(state, side, choice, foe_move) {
+        if we_ko {
+            return PivotDecision::Try;
+        }
+        if damager && we_2hko {
+            return if foe_best >= hp {
+                PivotDecision::Pivot
+            } else {
+                PivotDecision::Dont
+            };
+        }
+        if !boosted && flags.walls_or_resists() {
+            return PivotDecision::Try;
+        }
+        return PivotDecision::Dont;
+    }
+    if foe_best >= hp {
+        return PivotDecision::Try;
+    }
+    if 2.0 * foe_best >= hp {
+        if we_ko {
+            return PivotDecision::Try;
+        }
+        return if damager && flags.ko && flags.outspeeds_walls_or_resists() {
+            PivotDecision::Pivot
+        } else {
+            PivotDecision::Dont
+        };
+    }
+    if we_ko {
+        return if !boosted {
+            PivotDecision::Try
+        } else {
+            PivotDecision::Dont
+        };
+    }
+    if we_2hko {
+        return if damager && flags.ko && flags.outspeeds_walls_or_resists() {
+            PivotDecision::Pivot
+        } else {
+            PivotDecision::Dont
+        };
+    }
+    if damager && flags.ko && flags.outspeeds {
+        return PivotDecision::Pivot;
+    }
+    if !boosted && flags.outspeeds_walls_or_resists() {
+        PivotDecision::Try
+    } else {
+        PivotDecision::Dont
+    }
+}
+
+fn damage_tier(
+    state: &State,
+    side: SideReference,
+    choice: &Choice,
+    foe_move: Option<&Choice>,
+    cls: FightingStyle,
+    avail_moves: &[(MoveChoice, PokemonMoveIndex)],
+) -> i32 {
+    let (my_side, foe_side) = state.get_both_sides_immutable(&side);
+    let active = my_side.get_active_immutable();
+    let foe = foe_side.get_active_immutable();
+    let foe_hp = hp_frac(foe);
+    let my_hp = hp_frac(active);
+    let d = hit_frac(state, side, choice);
+    let kos = d >= foe_hp;
+    let first = goes_first(state, side, choice, foe_move);
+    let has_protect = active
+        .moves
+        .into_iter()
+        .any(|m| m.id != Choices::NONE && is_protect_move(m.id));
+    let dies = foe_move.map_or(false, |fm| {
+        hit_frac(state, side.get_other_side(), fm) >= my_hp
+    });
+
+    if kos && first && (choice.accuracy >= 70.0 || dies) {
+        return KO_BONUS;
+    }
+    if kos && !first && !has_protect {
+        return if cls == FightingStyle::SetupStats {
+            6
+        } else {
+            8
+        };
+    }
+
+    let attacks: Vec<&Choice> = avail_moves
+        .iter()
+        .map(|&(_, mi)| &active.moves[&mi].choice)
+        .filter(|c| c.category != MoveCategory::Status)
+        .collect();
+    if attacks.is_empty() {
+        return 0;
+    }
+
+    // Desperation: dying this turn -> strongest move that goes first gets KO_BONUS.
+    if dies
+        && !has_protect
+        && !matches!(
+            cls,
+            FightingStyle::Stall | FightingStyle::Phazer | FightingStyle::Hazards
+        )
+    {
+        let mut best_fast: Option<(&Choice, f32)> = None;
+        for &c in &attacks {
+            if goes_first(state, side, c, foe_move) {
+                let capped = hit_frac(state, side, c).min(foe_hp);
+                if best_fast.map_or(true, |(_, bd)| capped > bd) {
+                    best_fast = Some((c, capped));
+                }
+            }
+        }
+        if let Some((bf, _)) = best_fast {
+            if choice.move_id == bf.move_id {
+                return KO_BONUS;
+            }
+        }
+    }
+
+    // Strongest usable attack: max by (min(hit, foe_hp), priority, accuracy).
+    let mut strongest: Option<(&Choice, f32, i8, f32)> = None;
+    for &c in &attacks {
+        let capped = hit_frac(state, side, c).min(foe_hp);
+        let key = (capped, c.priority, c.accuracy);
+        let better = match strongest {
+            None => true,
+            Some((_, bd, bp, ba)) => {
+                key.0 > bd
+                    || (key.0 == bd && (key.1 > bp || (key.1 == bp && key.2 > ba)))
+            }
+        };
+        if better {
+            strongest = Some((c, key.0, key.1, key.2));
+        }
+    }
+    if let Some((st, _, _, _)) = strongest {
+        if choice.move_id == st.move_id {
+            if kos && matches!(cls, FightingStyle::Stall | FightingStyle::Phazer) {
+                return 8;
+            }
+            if kos && cls == FightingStyle::Hazards {
+                return 4;
+            }
+            return 2;
+        }
+    }
+    0
+}
+
+#[allow(clippy::too_many_arguments)]
+fn positives(
+    state: &State,
+    side: SideReference,
+    choice: &Choice,
+    cls: FightingStyle,
+    foe_move: Option<&Choice>,
+    foe_best: f32,
+    avail_moves: &[(MoveChoice, PokemonMoveIndex)],
+    ranked: &[RankedSwitch],
+) -> i32 {
+    let (my_side, foe_side) = state.get_both_sides_immutable(&side);
+    let active = my_side.get_active_immutable();
+    let foe = foe_side.get_active_immutable();
+    let sv = |b: i32| status_viability(cls, b, state, side);
+    let mut bonus = 0;
+
+    // Status moves & >=75% secondary status
+    let mut status = choice
+        .status
+        .as_ref()
+        .filter(|s| s.target == MoveTarget::Opponent)
+        .map(|s| s.status);
+    if status.is_none() {
+        if let Some(secs) = &choice.secondaries {
+            if let Some(sec) = secs.first() {
+                if sec.target == MoveTarget::Opponent && sec.chance >= 75.0 {
+                    if let Effect::Status(st) = sec.effect {
+                        status = Some(st);
+                    }
+                }
+            }
+        }
+    }
+    if let Some(st) = status {
+        if !bad_status(st, foe, active) {
+            match st {
+                PokemonStatus::POISON | PokemonStatus::TOXIC => {
+                    let boost = if mon_has_move(active, Choices::VENOSHOCK)
+                        || mon_has_move(active, Choices::BARBBARRAGE)
+                    {
+                        2
+                    } else {
+                        1
+                    };
+                    bonus += sv(boost);
+                }
+                PokemonStatus::PARALYZE => {
+                    let me = get_effective_speed(state, &side) as f32;
+                    let them = get_effective_speed(state, &side.get_other_side()) as f32;
+                    bonus += sv(if them >= me && me > them * 0.5 { 2 } else { 1 });
+                }
+                PokemonStatus::BURN => {
+                    let phys = foe_move.map_or(false, |fm| fm.category == MoveCategory::Physical);
+                    if phys
+                        && foe_move.map_or(false, |fm| {
+                            hit_frac(state, side.get_other_side(), fm) >= hp_frac(active)
+                        })
+                    {
+                        bonus += sv(3);
+                    } else {
+                        let any_phys = attacks_of(foe).any(|c| c.category == MoveCategory::Physical);
+                        bonus += sv(if any_phys { 2 } else { 1 });
+                    }
+                }
+                PokemonStatus::SLEEP => match cls {
+                    FightingStyle::SetupStats | FightingStyle::BatonPass => {
+                        bonus += if choice.accuracy >= 80.0 { 9 } else { sv(3) };
+                    }
+                    FightingStyle::SetupStatus => {
+                        bonus += if choice.accuracy >= 80.0 { 8 } else { sv(3) };
+                    }
+                    _ => bonus += sv(3),
+                },
+                _ => {}
+            }
+        }
+    }
+
+    // Recovery & draining moves
+    let heals = is_recovery_move(choice)
+        || (choice.drain.is_some() && choice.category != MoveCategory::Status);
+    if heals && should_recover(state, side, choice, foe_move, foe_best) {
+        if choice.drain.is_some() {
+            bonus += if cls == FightingStyle::Stall { sv(2) } else { 3 };
+        } else if matches!(cls, FightingStyle::Stall | FightingStyle::Phazer) {
+            bonus += 8;
+        } else {
+            bonus += sv(3);
+        }
+    }
+
+    // Protect
+    if is_protect_move(choice.move_id) && should_protect(state, side, foe_best) {
+        if cls == FightingStyle::Stall {
+            bonus += if my_side.trapped(foe) { 7 } else { 3 };
+        } else {
+            bonus += sv(3);
+        }
+    }
+
+    // Stat boosts (including Stockpile and >=75% self-boosting attacks like Power-Up Punch)
+    let mut boosts = self_boosts(choice);
+    if choice.move_id == Choices::STOCKPILE {
+        if mon_has_move(active, Choices::SWALLOW) || mon_has_move(active, Choices::SPITUP) {
+            bonus += sv(2);
+        } else {
+            boosts = Some(StatBoosts {
+                defense: 1,
+                special_defense: 1,
+                ..Default::default()
+            });
+        }
+    }
+    if choice.category != MoveCategory::Status {
+        if let Some(secs) = &choice.secondaries {
+            if let Some(sec) = secs.first() {
+                if sec.target == MoveTarget::User && sec.chance >= 75.0 {
+                    if let Effect::Boost(b) = &sec.effect {
+                        boosts = Some(b.clone());
+                    }
+                }
+            }
+        }
+    }
+    if let Some(b) = boosts {
+        let order = [
+            (PokemonBoostableStat::Attack, b.attack),
+            (PokemonBoostableStat::SpecialAttack, b.special_attack),
+            (PokemonBoostableStat::Speed, b.speed),
+            (PokemonBoostableStat::Defense, b.defense),
+            (PokemonBoostableStat::SpecialDefense, b.special_defense),
+        ];
+        if let Some(&(stat, _)) = order
+            .iter()
+            .find(|&&(st, v)| v > 0 && good_to_raise(st, state, side))
+        {
+            bonus += stat_viability(cls, state, side, choice, foe_move, foe_best, stat);
+        }
+    }
+
+    // Entry hazards
+    if is_hazard_move(choice.move_id) && cls != FightingStyle::Kill {
+        let left = n_remaining(foe_side);
+        if left > 2 {
+            bonus += sv(2);
+        } else if cls == FightingStyle::Stall {
+            bonus += sv(1);
+        }
+    }
+
+    // Pivot moves (U-turn, Flip Turn, Volt Switch, Parting Shot, Teleport...)
+    if is_pivot_move(choice) {
+        match should_pivot(state, side, choice, foe_move, foe_best, cls, ranked) {
+            PivotDecision::Pivot => {
+                bonus += if cls == FightingStyle::Kill { 3 } else { 9 };
+            }
+            PivotDecision::Dont => bonus -= 9,
+            PivotDecision::Try => {}
+        }
+    }
+
+    // Damage tiers
+    if choice.category != MoveCategory::Status {
+        bonus += damage_tier(state, side, choice, foe_move, cls, avail_moves);
+    }
+
+    bonus
+}
