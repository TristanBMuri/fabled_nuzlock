+#[cfg(feature = "rr")]
+#[pyfunction]
+fn rr_ai_choice(py_state: PyState, side: String) -> PyResult<Vec<String>> {
+    let state: State = py_state.into();
+    let side_ref = match side.to_lowercase().as_str() {
+        "side_one" | "sideone" | "s1" | "p1" | "1" => poke_engine::state::SideReference::SideOne,
+        "side_two" | "sidetwo" | "s2" | "p2" | "2" => poke_engine::state::SideReference::SideTwo,
+        _ => {
+            return Err(PyErr::new::<pyo3::exceptions::PyValueError, _>(format!(
+                "Invalid side: {} (expected side_one/s1/p1 or side_two/s2/p2)",
+                side
+            )))
+        }
+    };
+    let choices = engine_rr_ai_choice(&state, side_ref);
+    let side_obj = state.get_side_immutable(&side_ref);
+    Ok(choices
+        .iter()
+        .map(|m| movechoice_to_string(side_obj, m))
+        .collect())
+}
+
+#[cfg(feature = "rr")]
+#[pyfunction]
+#[pyo3(signature = (py_state, duration_ms=1000, iterations=0))]
+fn mcts_vs_ai(
+    py_state: PyState,
+    duration_ms: u64,
+    mut iterations: u32,
+) -> PyResult<PyMctsResult> {
+    let mut state: State = py_state.into();
+    let duration = Duration::from_millis(duration_ms);
+    let (s1_options, _) = state.root_get_all_options();
+    if s1_options.len() <= 1 {
+        iterations = 100;
+    }
+    let mcts_result = perform_mcts_vs_ai(&mut state, s1_options, duration, iterations);
+    Ok(PyMctsResult::from_mcts_result(mcts_result, &state))
+}
